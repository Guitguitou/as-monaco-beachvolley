<div id="<%= dom_id %>" class="<%= card_classes %>">
  <%# Bandeau de terrain : le joueur reconnaît son terrain à la couleur %>
  <div class="<%= terrain_bar_classes %> h-2" aria-hidden="true"></div>

  <div class="p-4 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-3">
      <%= render BadgeComponent.new(
        label: helpers.get_session_type_label(session.session_type),
        variant: accent ? :"type_#{accent}" : :neutral,
        icon: helpers.session_type_icon(session.session_type)
      ) %>
      <span class="text-xs font-semibold text-gray-600 shrink-0"><%= terrain_label %></span>
    </div>

    <%= link_to session_path(session, return_params),
                class: "mt-3 block group focus:outline-none focus-visible:ring-2 focus-visible:ring-asmbv-red" do %>
      <p class="font-anton text-lg uppercase leading-tight tracking-tight text-gray-900 group-hover:text-asmbv-red">
        <%= title %>
      </p>
    <% end %>

    <%# first-letter et non capitalize : « Vendredi 28 août », pas « Vendredi 28 Août ».
        La pseudo-classe ne s'applique qu'aux éléments de bloc, donc sur le <p>. %>
    <p class="mt-1.5 text-sm font-semibold text-gray-900 first-letter:uppercase">
      <%= day_label %>
    </p>
    <p class="text-sm text-gray-600">
      <%= time_range %><% if duration %> · <%= duration %><% end %>
    </p>

    <%# Qui vient : premier critère de décision d'un joueur %>
    <div class="mt-4 flex items-center gap-3 min-h-[2.25rem]">
      <% if confirmed_participants.any? %>
        <div class="flex -space-x-2">
          <% confirmed_participants.first(SessionCardComponent::MAX_AVATARS).each do |participant| %>
            <%= render AvatarComponent.new(user: participant, size: :xs, variant: :light, ring: true) %>
          <% end %>
        </div>
        <p class="text-xs text-gray-600 min-w-0">
          <% if extra_participants.positive? %>
            +<%= extra_participants %> autre<%= "s" if extra_participants > 1 %>
          <% end %>
        </p>
      <% else %>
        <p class="text-xs text-gray-500 italic">Personne encore inscrit — sois le premier</p>
      <% end %>
    </div>

    <div class="mt-3 flex items-center justify-between gap-3 text-xs">
      <span class="font-semibold <%= full? ? 'text-asmbv-red' : 'text-green-700' %>">
        <%= spots_label %>
      </span>
      <span class="text-gray-600"><%= price_label %></span>
    </div>

    <%# Signalements : uniquement ce qui n'est pas déjà dit par le bouton %>
    <% if registered? || waitlisted? || off_level? %>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <% if registered? %>
          <%= render BadgeComponent.new(label: "Inscrit", variant: :success, icon: "check-circle") %>
        <% elsif waitlisted? %>
          <%= render BadgeComponent.new(label: "Liste d'attente", variant: :warning, icon: "clock") %>
        <% end %>
        <% if off_level? %>
          <%= render BadgeComponent.new(label: "Hors niveau", variant: :neutral, icon: "sparkles") %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 pt-3 border-t border-gray-100">
      <% if actionable? %>
        <%= button_to action_path,
                      method: action_method,
                      params: action_params,
                      form: { data: { turbo_confirm: confirm_message }.compact },
                      class: action_button_classes do %>
          <%= lucide_icon(action_icon, class: "w-4 h-4 shrink-0") %>
          <span><%= action_label %></span>
        <% end %>
      <% else %>
        <span class="<%= action_button_classes %>" aria-disabled="true">
          <%= lucide_icon(action_icon, class: "w-4 h-4 shrink-0") %>
          <span class="truncate"><%= action_label %></span>
        </span>
      <% end %>
    </div>
  </div>
</div>
