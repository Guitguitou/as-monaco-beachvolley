<header class="bg-white border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 py-4 sm:py-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <div class="min-w-0">
      <h1 class="font-anton text-2xl sm:text-3xl uppercase tracking-tight leading-none text-gray-900">
        <%= title %>
      </h1>
      <% if subtitle.present? %>
        <p class="mt-1.5 text-sm text-gray-600"><%= subtitle %></p>
      <% end %>
    </div>

    <% if actions %>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <%= actions %>
      </div>
    <% end %>
  </div>
</header>
