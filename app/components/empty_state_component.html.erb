<div class="<%= wrapper_classes %>">
  <%= lucide_icon(icon, class: icon_classes, aria: { hidden: true }) %>

  <p class="mt-3 font-anton text-xl uppercase tracking-tight text-gray-900"><%= title %></p>

  <% if description.present? %>
    <p class="mt-1 text-sm text-gray-600"><%= description %></p>
  <% end %>

  <% if action %>
    <div class="mt-4">
      <%= action %>
    </div>
  <% end %>
</div>
