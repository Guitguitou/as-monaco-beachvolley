<div>
  <p class="text-center text-sm italic text-gray-500">« <%= title %> »</p>

  <% if has_players? %>
    <ol class="mt-5 grid grid-cols-3 items-end gap-2 sm:gap-3">
      <% places.each do |position, player| %>
        <% step = step(position) %>
        <li class="<%= step[:order] %> flex min-w-0 flex-col items-center text-center">
          <% if player %>
            <div class="relative">
              <% if position == 1 %>
                <%= lucide_icon("crown", class: "absolute -top-5 left-1/2 w-5 h-5 -translate-x-1/2 text-asmbv-gold", aria: { hidden: true }) %>
              <% end %>
              <span class="inline-flex rounded-full <%= me?(player) ? 'ring-2 ring-asmbv-red ring-offset-2' : '' %>">
                <%= render AvatarComponent.new(user: player[:user], size: avatar_size(position), variant: position == 1 ? :solid : :dark) %>
              </span>
              <span class="absolute -bottom-1 -right-1 text-base leading-none" aria-label="<%= position %>e place"><%= medal_emoji(position) %></span>
            </div>

            <p class="mt-2 w-full text-xs sm:text-sm font-semibold text-gray-900 line-clamp-2 break-words" title="<%= player[:name] %>">
              <%= player[:name] %>
            </p>
            <% if me?(player) %>
              <span class="mt-0.5 rounded-full bg-asmbv-red px-1.5 py-px text-[10px] font-bold uppercase tracking-wide text-white">Toi</span>
            <% end %>
            <p class="mt-1 leading-none">
              <span class="font-anton text-xl tabular-nums text-gray-900"><%= score(player).value %></span>
              <span class="text-[11px] text-gray-500"><%= score(player).unit %></span>
            </p>
            <% if score(player).detail %>
              <p class="mt-0.5 text-[10px] text-gray-400"><%= score(player).detail %></p>
            <% end %>

            <div class="mt-2 w-full <%= step[:height] %> <%= step[:tone] %> <%= step[:delay] %> rounded-t-lg origin-bottom animate-rise motion-reduce:animate-none flex items-start justify-center pt-1.5">
              <span class="font-anton text-2xl leading-none"><%= position %></span>
            </div>
          <% else %>
            <div class="mt-2 w-full <%= step[:height] %> rounded-t-lg border-2 border-dashed border-gray-200 flex items-start justify-center pt-1.5">
              <span class="font-anton text-2xl leading-none text-gray-200"><%= position %></span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <div class="mt-5 flex flex-col items-center justify-center rounded-lg bg-gray-50 py-10 text-center">
      <%= lucide_icon("trophy", class: "w-8 h-8 text-gray-300", aria: { hidden: true }) %>
      <p class="mt-2 text-sm text-gray-400"><%= empty_message %></p>
    </div>
  <% end %>
</div>
