<% if form? %>
  <%= button_to url, method: options[:method], data: options[:data], form: options[:form], class: classes do %>
    <%= icon_svg %>
    <%= content %>
  <% end %>
<% else %>
  <%= content_tag tag_name, options.except(:icon, :class, :method).merge(class: classes) do %>
    <%= icon_svg %>
    <%= content %>
  <% end %>
<% end %>
