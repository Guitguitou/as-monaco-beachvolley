<div class="mb-8">
  <!-- Tab Navigation -->
  <div class="border-b border-gray-200 overflow-x-auto">
    <nav class="-mb-px flex space-x-8" data-controller="tabs">
      <% tabs.each do |tab| %>
        <%= link_to helpers.admin_root_path(tab: tab[:id]), 
            class: tab_classes(tab[:id]),
            data: { 
              action: "click->tabs#switchTab",
              tab: tab[:id]
            } do %>
          <%= lucide_icon(tab[:icon], class: "w-4 h-4 mr-2 inline") %>
          <%= tab[:name] %>
        <% end %>
      <% end %>
    </nav>
  </div>

  <!-- Tab Content -->
  <div class="mt-6">
    <%= content %>
  </div>
</div>
