<nav class="flex-1 space-y-1 text-sm" aria-label="Administration">
  <% sections.each do |section| %>
    <% if section.single? %>
      <%= link_for(section.items.first) %>
    <% else %>
      <details class="group" <%= "open" if section.active?(location) %>>
        <summary class="flex items-center justify-between gap-2 px-3 py-2 cursor-pointer list-none text-xs font-semibold uppercase tracking-wide text-gray-500 hover:text-gray-900">
          <span class="flex items-center gap-2"><%= lucide_icon(section.icon, class: "w-4 h-4") %><%= section.title %></span>
          <%= lucide_icon("chevron-down", class: "w-4 h-4 transition-transform group-open:rotate-180") %>
        </summary>
        <div class="space-y-1 pb-2">
          <% section.items.each do |item| %>
            <%= link_for(item) %>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</nav>
