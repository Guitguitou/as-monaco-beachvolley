<div class="bg-white rounded-none shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h3 class="text-lg font-medium text-gray-900 flex items-center">
        <%= lucide_icon('chart-column', class: 'w-5 h-5 mr-2 text-brand') %>
        Évolution mensuelle du CA
      </h3>
      <p class="text-sm text-gray-500 mt-1"><%= months.size %> derniers mois, par type de pack — le mois en cours est partiel</p>
    </div>
    <div class="text-right">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= month_title(current_month) %></p>
      <p class="text-2xl font-semibold text-gray-900 tabular-nums"><%= format_currency(current_month[:total]) %></p>
      <% if previous_month %>
        <% change = delta(current_month[:total], previous_month[:total]) %>
        <p class="text-xs <%= delta_classes(change) %>">
          <%= format_delta(change) %> <span class="text-gray-500">vs <%= month_label(previous_month) %></span>
        </p>
      <% end %>
    </div>
  </div>

  <% if empty? %>
    <p class="text-gray-500 text-center py-8">Aucune vente de pack sur la période</p>
  <% else %>
    <div class="p-6 space-y-4">
      <%= helpers.column_chart series, stacked: true, suffix: " €", id: "monthly-revenue-chart" %>
    </div>

    <div class="overflow-x-auto border-t border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mois</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
            <% types.each do |type| %>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">
                <%= type_label(type) %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% comparison_rows.each do |month, previous| %>
            <tr>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900"><%= month_title(month) %></td>
              <% comparison_cells(month, previous).each_with_index do |(value, change), column| %>
                <td class="px-4 py-3 whitespace-nowrap text-right tabular-nums">
                  <span class="text-sm text-gray-900 <%= 'font-bold' if column.zero? %>"><%= format_currency(value) %></span>
                  <span class="block text-xs <%= delta_classes(change) %>"><%= format_delta(change) %></span>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
