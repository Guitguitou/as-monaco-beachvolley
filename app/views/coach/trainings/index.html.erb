<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
        <%= lucide_icon("users", class: "w-6 h-6 text-asmbv-red") %>
        Espace Entraîneur
      </h1>
    </div>

    <!-- Tabs Navigation -->
    <%= tab_bar([
      { label: "Bibliothèque des entraînements", href: coach_trainings_path(tab: "library"), active: @active_tab == "library", icon: "book-open" },
      { label: "Mes entraînements", href: coach_trainings_path(tab: "my_trainings"), active: @active_tab == "my_trainings", icon: "user" }
    ]) %>

    <!-- Tab Content -->
    <% if @active_tab == 'library' %>
      <%= render 'library_tab' %>
    <% elsif @active_tab == 'my_trainings' %>
      <%= render 'my_trainings_tab' %>
    <% end %>
  </div>
</div>
