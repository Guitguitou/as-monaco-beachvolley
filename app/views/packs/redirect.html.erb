<%# Page de transition avant la bascule vers la page de paiement LCL.
    Le formulaire est posté automatiquement ; le bouton reste la porte de
    sortie si le script ne s'exécute pas. %>
<div class="max-w-md mx-auto">
  <%= render CardComponent.new(padding: :none, class_name: "p-8 text-center") do %>
    <p class="text-xs uppercase tracking-widest text-gray-500 font-semibold mb-3">Boutique</p>

    <div class="flex justify-center mb-5">
      <div class="h-12 w-12 border-4 border-gray-200 border-t-brand rounded-full animate-spin"></div>
    </div>

    <h1 class="font-bebas-neue text-3xl tracking-wider text-gray-900 uppercase mb-2">
      Redirection en cours
    </h1>
    <p class="text-sm text-gray-600 mb-1">
      Tu vas être redirigé vers la page de paiement sécurisée de LCL.
    </p>
    <p class="text-sm text-gray-900 font-semibold mb-6">
      <%= local_assigns.fetch(:label) { @credit_purchase.pack.name } %> — <%= number_to_currency(@credit_purchase.amount_eur, unit: "€", format: "%n %u") %>
    </p>

    <%= form_tag @payment_request.url, method: :post, authenticity_token: false,
          id: "sherlock-payment", data: { turbo: false } do %>
      <% @payment_request.fields.each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil %>
      <% end %>

      <%# name/value reprennent ceux de submit_tag : le formulaire envoyé à Sherlock ne change pas. %>
      <%= render ButtonComponent.new(type: "submit", name: "commit", value: "Continuer vers le paiement",
                                     size: :large, full_width: true) do %>
        Continuer vers le paiement
      <% end %>
    <% end %>

    <p class="text-xs text-gray-500 mt-4">
      Ne ferme pas cette page. Si rien ne se passe, utilise le bouton ci-dessus.
    </p>
  <% end %>
</div>

<% content_for :scripts do %>
  <script>
    document.getElementById("sherlock-payment").submit();
  </script>
<% end %>
