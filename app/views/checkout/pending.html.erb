<div class="max-w-2xl mx-auto">
  <%= render CardComponent.new(padding: :none, class_name: "overflow-hidden") do %>
    <div class="bg-gradient-to-r from-gray-800 to-gray-900 p-8 text-white text-center">
      <p class="text-xs uppercase tracking-widest text-white font-semibold mb-3">Boutique</p>
      <div class="flex justify-center mb-4">
        <div class="p-4 bg-white/20 rounded-none">
          <%= lucide_icon("hourglass", size: 64) %>
        </div>
      </div>
      <h1 class="font-bebas-neue text-5xl tracking-wider uppercase mb-2">Paiement en cours</h1>
      <p class="text-base">La banque n'a pas encore confirmé la transaction.</p>
    </div>

    <div class="p-8">
      <div class="bg-gray-50 border border-gray-200 rounded-none p-4 mb-6">
        <div class="flex gap-3">
          <%= lucide_icon("info", size: 20, class: "text-gray-700 flex-shrink-0 mt-0.5") %>
          <div class="text-sm text-gray-700">
            <p class="font-semibold mb-1">Rien à faire de ton côté</p>
            <p>
              Dès que LCL nous confirme le paiement, ton achat est validé et tu reçois un email.
              Recharge cette page dans quelques instants, ou contacte-nous avec la référence
              ci-dessous si rien ne bouge.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-none p-4 mb-6 space-y-2">
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-600">Montant</span>
          <span class="font-semibold text-gray-900"><%= number_to_currency(@credit_purchase.amount_eur, unit: "€", format: "%n %u") %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-600">Référence de transaction</span>
          <span class="font-mono text-gray-900"><%= @credit_purchase.sherlock_transaction_reference %></span>
        </div>
      </div>

      <%= render ButtonComponent.new(href: packs_path, variant: :secondary, size: :large, full_width: true) do %>
        <%= lucide_icon("package", size: 20) %>
        Voir les packs
      <% end %>
    </div>
  <% end %>
</div>
