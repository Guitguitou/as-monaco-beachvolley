<div class="max-w-2xl mx-auto">
  <%= render CardComponent.new(padding: :none, class_name: "overflow-hidden") do %>
    <%# Cancel header with gradient %>
    <div class="bg-gradient-to-r from-brand to-brand-dark p-8 text-white text-center">
      <p class="text-xs uppercase tracking-widest text-white font-semibold mb-3">Boutique</p>
      <div class="flex justify-center mb-4">
        <div class="p-4 bg-white/20 rounded-none">
          <%= lucide_icon("x-circle", size: 64) %>
        </div>
      </div>
      <h1 class="font-bebas-neue text-5xl tracking-wider uppercase mb-2">Paiement annulé</h1>
      <p class="text-base">Aucun débit n'a été effectué.</p>
    </div>

    <%# Content %>
    <div class="p-8">
      <div class="text-center mb-6">
        <p class="text-gray-600 mb-2">Aucun débit n'a été effectué sur ton compte.</p>
        <p class="text-sm text-gray-500">
          Référence : <span class="font-mono"><%= @credit_purchase.sherlock_transaction_reference %></span>
        </p>
      </div>

      <%# Info box %>
      <div class="bg-gray-50 border border-gray-200 rounded-none p-4 mb-6">
        <div class="flex gap-3">
          <%= lucide_icon("info", size: 20, class: "text-gray-700 flex-shrink-0 mt-0.5") %>
          <div class="text-sm text-gray-700">
            <p class="font-semibold mb-1">Tu as changé d'avis ?</p>
            <p>Tu peux réessayer à tout moment depuis la boutique.</p>
          </div>
        </div>
      </div>

      <%# Actions %>
      <div class="flex flex-col sm:flex-row gap-3">
        <% if @credit_purchase.pack %>
          <%= render ButtonComponent.new(href: buy_pack_path(@credit_purchase.pack), method: :post, data: { turbo: false }, size: :large, class: "flex-1") do %>
            <%= lucide_icon("refresh-cw", size: 20) %>
            Réessayer
          <% end %>
        <% end %>

        <%= render ButtonComponent.new(href: packs_path, variant: :secondary, size: :large, class: "flex-1") do %>
          <%= lucide_icon("package", size: 20) %>
          Voir les packs
        <% end %>
      </div>
    </div>
  <% end %>
</div>
