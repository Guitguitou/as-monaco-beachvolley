<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= @public_page.display_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="AS Monaco Beach Volley">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:title" content="<%= @public_page.display_title %>">
    <% if @public_page.meta_description.present? %>
      <meta name="description" content="<%= @public_page.meta_description %>">
      <meta property="og:description" content="<%= @public_page.meta_description %>">
    <% end %>
    <% if @public_page.meta_image.present? %>
      <meta property="og:image" content="<%= @public_page.meta_image %>">
      <meta name="twitter:card" content="summary_large_image">
    <% end %>
    <%= favicon_link_tag "logo.png" %>
    <style>html, body { margin: 0; height: 100%; } iframe { display: block; width: 100%; height: 100%; border: 0; }</style>
  </head>
  <body>
    <iframe src="<%= @public_page.script_url %>" title="<%= @public_page.display_title %>" allow="clipboard-write"></iframe>
  </body>
</html>
