<%# Photo de profil, cadrée dans le cercle : glisser pour centrer, curseur
    pour zoomer. Le cadrage est rejoué par AvatarComponent partout dans l'app. %>
<div class="flex flex-col sm:flex-row sm:items-center gap-5" data-controller="avatar-crop">
  <div class="relative h-32 w-32 shrink-0 overflow-hidden rounded-full bg-brand text-white
              touch-none cursor-grab active:cursor-grabbing select-none"
       data-action="pointerdown->avatar-crop#startDrag pointermove->avatar-crop#moveDrag
                    pointerup->avatar-crop#endDrag pointercancel->avatar-crop#endDrag">
    <img src="<%= url_for(user.avatar) if user.avatar.attached? && user.avatar.blob.persisted? %>"
         alt="Aperçu de la photo de profil" draggable="false"
         class="absolute inset-0 h-full w-full object-cover pointer-events-none"
         data-avatar-crop-target="image">
    <span class="absolute inset-0 flex items-center justify-center font-anton text-4xl"
          data-avatar-crop-target="placeholder">
      <%= AvatarComponent.new(user: user).initials %>
    </span>
  </div>

  <div class="flex-1 min-w-0 space-y-3">
    <label class="block">
      <span class="block text-sm font-semibold text-gray-900">Photo de profil</span>
      <%= form.file_field :avatar, accept: AvatarValidator::CONTENT_TYPES.join(","),
                          data: { avatar_crop_target: "input", action: "change->avatar-crop#pick" },
                          class: "mt-1 block w-full text-sm text-gray-600 file:mr-3 file:rounded-none file:border-0 " \
                                 "file:bg-gray-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white " \
                                 "hover:file:bg-gray-700 cursor-pointer" %>
    </label>

    <div class="space-y-2" data-avatar-crop-target="editor">
      <p class="text-xs text-gray-500">Glisse la photo pour la centrer dans le cercle.</p>
      <label class="flex items-center gap-3 text-xs font-semibold text-gray-700">
        Zoom
        <%= form.range_field :avatar_zoom, min: 1, max: 3, step: 0.05,
                             data: { avatar_crop_target: "zoom", action: "input->avatar-crop#render" },
                             class: "flex-1 accent-brand" %>
      </label>
      <%= form.hidden_field :avatar_crop_x, data: { avatar_crop_target: "x" } %>
      <%= form.hidden_field :avatar_crop_y, data: { avatar_crop_target: "y" } %>

      <% if user.avatar.attached? && user.avatar.blob.persisted? %>
        <label class="inline-flex items-center gap-2 text-xs text-gray-600">
          <%= form.check_box :remove_avatar, data: { avatar_crop_target: "remove" },
                             class: "rounded-none border-gray-300 text-brand focus:ring-brand" %>
          Retirer ma photo
        </label>
      <% end %>
    </div>
  </div>
</div>
