<%= render CardComponent.new(padding: :none) do %>
  <% if pagination.any? %>
    <div class="hidden sm:block overflow-x-auto">
      <table class="min-w-full text-sm text-left">
        <thead class="bg-gray-50 text-[11px] font-bold text-gray-500 uppercase tracking-widest">
          <tr>
            <th class="px-5 py-3">Date</th>
            <th class="px-5 py-3">Achat</th>
            <th class="px-5 py-3">Statut</th>
            <th class="px-5 py-3">Référence</th>
            <th class="px-5 py-3 text-right">Montant</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% pagination.records.each do |purchase| %>
            <tr class="hover:bg-gray-50/60 transition-colors">
              <td class="px-5 py-3 whitespace-nowrap text-xs text-gray-500">
                <%= l((purchase.paid_at || purchase.created_at), format: :short) %>
              </td>
              <td class="px-5 py-3 font-semibold text-gray-900">
                <%= purchase.pack&.name.presence || "Achat" %>
              </td>
              <td class="px-5 py-3">
                <%= render BadgeComponent.new(
                      label: credit_purchase_status_label(purchase.status),
                      variant: credit_purchase_status_variant(purchase.status),
                      size: :xs
                    ) %>
              </td>
              <td class="px-5 py-3 text-xs text-gray-500 font-mono"><%= purchase.sherlock_transaction_reference.presence || "—" %></td>
              <td class="px-5 py-3 text-right font-bold tabular-nums text-gray-900">
                <%= purchase_amount(purchase) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="sm:hidden divide-y divide-gray-100">
      <% pagination.records.each do |purchase| %>
        <li class="px-5 py-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-semibold text-gray-900 truncate"><%= purchase.pack&.name.presence || "Achat" %></p>
              <p class="mt-0.5 text-xs text-gray-500">
                <%= l((purchase.paid_at || purchase.created_at), format: :short) %>
              </p>
            </div>
            <p class="shrink-0 font-bold tabular-nums text-gray-900"><%= purchase_amount(purchase) %></p>
          </div>
          <div class="mt-2 flex items-center gap-2">
            <%= render BadgeComponent.new(
                  label: credit_purchase_status_label(purchase.status),
                  variant: credit_purchase_status_variant(purchase.status),
                  size: :xs
                ) %>
            <% if purchase.sherlock_transaction_reference.present? %>
              <span class="text-[10px] text-gray-400 font-mono truncate"><%= purchase.sherlock_transaction_reference %></span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <%= render "pagination", pagination: pagination, history: "purchases" %>
  <% else %>
    <%= render EmptyStateComponent.new(
          icon: "receipt",
          title: "Aucun achat",
          description: "Licence, crédits et stages achetés apparaîtront ici.",
          compact: true
        ) do |empty| %>
      <% empty.with_action do %>
        <%= button("Voir la boutique", variant: :secondary, size: :small,
                   href: packs_path, data: { turbo_frame: "_top" }) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
