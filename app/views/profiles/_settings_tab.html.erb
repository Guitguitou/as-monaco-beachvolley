<div class="space-y-10">

  <%# 1. Mon identité — le formulaire d'édition, inexistant jusqu'ici : la page
      affichait le nom et l'email sans aucun moyen de les changer. %>
  <section>
    <%= render SectionHeaderComponent.new(
          title: "Mon identité",
          subtitle: "Ce nom apparaît sur les listes de participants."
        ) %>

    <%= render CardComponent.new(padding: :lg, class_name: "mt-4") do %>
      <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-4" do |f| %>
        <% if @user.errors.any? %>
          <div class="border-l-4 border-asmbv-red bg-asmbv-red-light p-4" role="alert">
            <p class="text-sm font-semibold text-gray-900">
              <%= fr_pluralize(@user.errors.count, "erreur empêche", "erreurs empêchent") %> l'enregistrement :
            </p>
            <ul class="mt-1 list-disc list-inside text-sm text-gray-700">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%= render FormFieldComponent.new(form: f, attribute: :first_name, label: "Prénom", required: true) %>
          <%= render FormFieldComponent.new(form: f, attribute: :last_name, label: "Nom", required: true) %>
        </div>

        <div class="flex items-center justify-between gap-4 flex-wrap">
          <p class="text-xs text-gray-500">
            Tes groupes et ta licence sont gérés par le club.
          </p>
          <%= f.submit "Enregistrer",
                       class: "inline-flex items-center justify-center rounded-none bg-asmbv-red px-4 py-2 " \
                              "text-sm font-semibold text-white transition-colors hover:bg-asmbv-red-dark " \
                              "focus:outline-none focus:ring-2 focus:ring-asmbv-red focus:ring-offset-2 cursor-pointer" %>
        </div>
      <% end %>
    <% end %>
  </section>

  <%# 2. Notifications — le bouton ne vivait que dans la navbar et la sidebar,
      alors qu'un réglage se cherche dans le profil. %>
  <% if vapid_public_key.present? %>
    <section>
      <%= render SectionHeaderComponent.new(
            title: "Notifications",
            subtitle: "Sois prévenu d'une place qui se libère ou d'une session annulée."
          ) %>

      <%= render CardComponent.new(padding: :lg, class_name: "mt-4") do %>
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <%= lucide_icon(@settings.push_enabled? ? "bell-ring" : "bell-off",
                              class: "w-5 h-5 shrink-0 #{@settings.push_enabled? ? 'text-asmbv-red' : 'text-gray-400'}",
                              aria: { hidden: true }) %>
              <p class="font-semibold text-gray-900">
                <%= @settings.push_enabled? ? "Notifications activées" : "Notifications désactivées" %>
              </p>
            </div>
            <p class="mt-1 text-sm text-gray-600">
              <% if @settings.push_enabled? %>
                <%= fr_pluralize(@settings.push_devices_count, "appareil enregistré", "appareils enregistrés") %>.
              <% else %>
                Active-les pour recevoir les alertes sur cet appareil.
              <% end %>
            </p>
          </div>

          <%# Même contrat Stimulus que la navbar : le contrôleur masque le
              bouton quand le navigateur ne le permet pas ou que la permission
              est déjà accordée. %>
          <button type="button"
                  data-action="click->push-notifications#requestPermission"
                  data-push-notifications-target="enableButton"
                  class="inline-flex items-center justify-center rounded-none border border-gray-200 bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-asmbv-red focus:ring-offset-2"
                  style="display: none;">
            Activer sur cet appareil
          </button>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# 3. Sécurité et compte %>
  <section>
    <%= render SectionHeaderComponent.new(title: "Mon compte") %>

    <div class="mt-4 border border-gray-200 bg-white rounded-xl divide-y divide-gray-100">
      <%# L'ancienne page proposait deux icônes distinctes pointant toutes
          les deux vers cette même page Devise. %>
      <%= link_to edit_user_registration_path, data: { turbo_frame: "_top" },
                  class: "flex items-center justify-between gap-4 px-5 py-4 hover:bg-gray-50" do %>
        <div class="flex items-center gap-3 min-w-0">
          <%= lucide_icon("key-round", class: "w-5 h-5 shrink-0 text-gray-400", aria: { hidden: true }) %>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-gray-900">Email et mot de passe</p>
            <p class="text-xs text-gray-600 truncate"><%= @user.email %></p>
          </div>
        </div>
        <%= lucide_icon("chevron-right", class: "w-4 h-4 shrink-0 text-gray-400", aria: { hidden: true }) %>
      <% end %>

      <% if @settings.admin_shortcut? %>
        <%= link_to admin_root_path, data: { turbo_frame: "_top" },
                    class: "flex items-center justify-between gap-4 px-5 py-4 hover:bg-gray-50" do %>
          <div class="flex items-center gap-3 min-w-0">
            <%= lucide_icon("shield-user", class: "w-5 h-5 shrink-0 text-gray-400", aria: { hidden: true }) %>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900">Administration</p>
              <p class="text-xs text-gray-600">
                <%= @settings.role_labels.to_sentence %>
              </p>
            </div>
          </div>
          <%= lucide_icon("chevron-right", class: "w-4 h-4 shrink-0 text-gray-400", aria: { hidden: true }) %>
        <% end %>
      <% end %>

      <%= link_to destroy_user_session_path, data: { turbo_method: :delete, turbo_frame: "_top" },
                  class: "flex items-center justify-between gap-4 px-5 py-4 hover:bg-gray-50" do %>
        <div class="flex items-center gap-3 min-w-0">
          <%= lucide_icon("log-out", class: "w-5 h-5 shrink-0 text-gray-400", aria: { hidden: true }) %>
          <p class="text-sm font-semibold text-gray-900">Se déconnecter</p>
        </div>
        <%= lucide_icon("chevron-right", class: "w-4 h-4 shrink-0 text-gray-400", aria: { hidden: true }) %>
      <% end %>
    </div>
  </section>
</div>
