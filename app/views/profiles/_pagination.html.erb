<%# Pagination minimale (aucune gem dans le projet). Reste dans le
    turbo_frame des onglets : la page suivante s'affiche sans rechargement. %>
<% if pagination.multiple_pages? %>
  <div class="flex items-center justify-between gap-4 px-5 py-3 border-t border-gray-100">
    <p class="text-xs text-gray-500">
      Page <%= pagination.current_page %> sur <%= pagination.total_pages %>
      · <%= pagination.total_count %> au total
    </p>

    <div class="flex items-center gap-2">
      <% if pagination.prev_page %>
        <%= link_to profile_path(tab: "season", history: history, page: pagination.prev_page),
                    data: { turbo_frame: "profile_tab", turbo_action: "advance" },
                    class: "inline-flex items-center gap-1 rounded-none border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50" do %>
          <%= lucide_icon("chevron-left", class: "w-3 h-3", aria: { hidden: true }) %>
          Précédent
        <% end %>
      <% end %>

      <% if pagination.next_page %>
        <%= link_to profile_path(tab: "season", history: history, page: pagination.next_page),
                    data: { turbo_frame: "profile_tab", turbo_action: "advance" },
                    class: "inline-flex items-center gap-1 rounded-none border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50" do %>
          Suivant
          <%= lucide_icon("chevron-right", class: "w-3 h-3", aria: { hidden: true }) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
