<div class="max-w-md mx-auto mt-16">
  <%= render CardComponent.new(padding: :lg, class_name: "border border-gray-200") do |card| %>
    <% card.with_header do %>
      <h2 class="text-2xl font-bold text-center text-gray-900">Connexion</h2>
    <% end %>

  <%= form_with model: resource, 
              as: resource_name, 
              url: user_session_path, 
              local: true,
              html: { class: "space-y-6" } do |f| %>

    <!-- Email -->
    <div>
      <%= render FormFieldComponent.new(
        form: f,
        attribute: :email,
        type: :email_field,
        label: "Adresse email",
        required: true,
        html_options: { autofocus: true }
      ) %>
    </div>

    <!-- Mot de passe -->
    <div>
      <%= render FormFieldComponent.new(
        form: f,
        attribute: :password,
        type: :password_field,
        label: "Mot de passe",
        required: true
      ) %>
    </div>

    <!-- Se souvenir de moi -->
    <% if devise_mapping.rememberable? %>
      <div class="flex items-center">
        <%= f.check_box :remember_me, 
              class: "h-4 w-4 text-brand border-gray-300 rounded-none focus:ring-brand" %>
        <%= f.label :remember_me, "Se souvenir de moi", 
              class: "ml-2 block text-sm text-gray-700" %>
      </div>
    <% end %>

    <!-- Bouton connexion -->
    <div>
      <%= render ButtonComponent.new(type: "submit", full_width: true) do %>Se connecter<% end %>
    </div>
  <% end %>

  <!-- Lien mot de passe oublié -->
  <div class="mt-4 text-center">
    <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), 
          class: "text-sm font-medium text-brand hover:text-brand-dark" %>
  </div>
  <% end %>
</div>
