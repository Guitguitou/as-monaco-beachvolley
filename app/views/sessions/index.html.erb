<%# Le titre de la page est porté par le PageHeaderComponent du layout
    (cf. ApplicationHelper::PAGE_TITLES) — ne pas le redupliquer ici. %>
<div class="mb-4">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <% current_view = @view.presence || params[:view].presence || "calendar" %>
    <div class="flex items-center gap-2" role="group" aria-label="Mode d'affichage">
      <%= button(
        "Grille",
        variant: :filter,
        size: :small,
        href: sessions_path(request.query_parameters.merge(view: "grid")),
        data: { filter_pill: "view" },
        aria: { pressed: (current_view == "grid").to_s }
      ) %>
      <%= button(
        "Calendrier",
        variant: :filter,
        size: :small,
        href: sessions_path(request.query_parameters.merge(view: "calendar")),
        data: { filter_pill: "view" },
        aria: { pressed: (current_view == "calendar").to_s }
      ) %>
    </div>

    <% if can?(:create, Session) %>
      <%= button("Nouvelle session", variant: :primary, size: :small, href: new_session_path(sessions_index_return_params)) %>
    <% end %>
  </div>

  <!-- Filtres de terrain -->
  <%= render "terrain_filter" %>
</div>

<% if (@view.presence || params[:view].presence || "calendar") == "grid" %>
  <%= render "grid" %>
<% else %>
<%# Sur mobile, un agenda (jours de la semaine, mes prochaines sessions, liste
    du jour) remplace la grille FullCalendar, illisible sur 375 px. %>
<div data-controller="dialog" id="session-preview">
  <%= render "mobile_agenda", agenda: @agenda %>

  <div class="hidden sm:block">
    <div
      id="calendar"
      data-controller="calendar"
      data-initial-date="<%= params[:date] %>"
      data-sessions="<%= json_escape(@events.to_json) %>"
      data-closures="<%= json_escape(@closures.to_json) %>"
      class="mt-4 bg-white p-2 sm:p-4 rounded-none">
    </div>
  </div>

  <%# Aperçu d'une session : modale centrée sur desktop, feuille en bas d'écran sur mobile. %>
  <dialog data-dialog-target="dialog" data-action="click->dialog#backdropClose"
          class="m-auto w-[min(94vw,30rem)] max-h-[90vh] rounded-none p-0 backdrop:bg-black/40
                 max-sm:mb-0 max-sm:w-full max-sm:max-w-full max-sm:max-h-[85vh]">
    <div class="relative p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
      <button type="button" data-action="dialog#close" aria-label="Fermer"
              class="absolute right-3 top-3 z-10 p-1 text-gray-500 hover:text-gray-900">
        <%= lucide_icon("x", class: "size-5", aria: { hidden: true }) %>
      </button>
      <turbo-frame id="session_preview" target="_top">
        <p class="py-8 text-center text-sm text-gray-500">Chargement…</p>
      </turbo-frame>
    </div>
  </dialog>
</div>
<% end %>
