<%# Le titre de la page est porté par le PageHeaderComponent du layout
    (cf. ApplicationHelper::PAGE_TITLES) — ne pas le redupliquer ici. %>
<div class="mb-4">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <% current_view = @view.presence || params[:view].presence || "calendar" %>
    <div class="flex items-center gap-2" role="group" aria-label="Mode d'affichage">
      <%= button(
        "Grille",
        variant: :filter,
        size: :small,
        href: sessions_path(request.query_parameters.merge(view: "grid")),
        data: { filter_pill: "view" },
        aria: { pressed: (current_view == "grid").to_s }
      ) %>
      <%= button(
        "Calendrier",
        variant: :filter,
        size: :small,
        href: sessions_path(request.query_parameters.merge(view: "calendar")),
        data: { filter_pill: "view" },
        aria: { pressed: (current_view == "calendar").to_s }
      ) %>
    </div>

    <% if can?(:create, Session) %>
      <%= button("Nouvelle session", variant: :primary, size: :small, href: new_session_path(sessions_index_return_params)) %>
    <% end %>
  </div>

  <!-- Filtres de terrain -->
  <%= render "terrain_filter" %>
</div>

<% if (@view.presence || params[:view].presence || "calendar") == "grid" %>
  <%= render "grid" %>
<% else %>
<div
  id="calendar"
  data-controller="calendar"
  data-initial-date="<%= params[:date] %>"
  data-sessions="<%= json_escape(@calendar.sessions.to_json) %>"
  data-closures="<%= json_escape(@calendar.closures.to_json) %>"
  class="mt-4 bg-white p-2 sm:p-4 rounded-xl">
</div>
<% end %>
