<% calendar_ctx = sessions_index_return_params %>
<% confirmed = @session.registrations.confirmed.includes(user: :levels).to_a %>
<%# Les places libres sont dessinées : « 3 places » se voit avant de se lire.
    Au-delà de quatre, la dernière case résume le reste. %>
<% max_empty_slots = 4 %>
<% free = @session.max_players.present? ? [ @session.max_players - confirmed.size, 0 ].max : 0 %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
  <% confirmed.each do |registration| %>
    <% user = registration.user %>
    <% me = user == current_user %>
    <div class="flex items-center gap-3 p-3 rounded-none border <%= me ? 'border-asmbv-red bg-asmbv-red/5' : 'border-gray-200 bg-gray-50' %>">
      <%= render AvatarComponent.new(user: user, size: :sm, variant: me ? :solid : :light) %>
      <div class="flex-1 min-w-0 flex items-center justify-between gap-2">
        <div class="min-w-0">
          <div class="font-medium text-sm text-gray-900 truncate">
            <%= user.full_name %><% if me %> <span class="text-asmbv-red font-semibold">· toi</span><% end %>
          </div>
          <% level_names = session_levels_label(user.levels) %>
          <% if level_names.present? %>
            <div class="text-xs text-gray-500 truncate"><%= level_names %></div>
          <% end %>
        </div>
        <% can_remove = if Time.current <= @session.end_at
          current_user&.admin? || current_user == @session.user
        else
          current_user&.admin?
        end %>
        <% if can_remove && current_user.staff? && Registrations::Cancellation.new(registration).late? %>
          <%= render "sessions/late_removal", registration: registration, calendar_ctx: calendar_ctx %>
        <% elsif can_remove %>
          <%= button_to session_registration_path(@session, calendar_ctx.merge(user_id: registration.user_id)), method: :delete,
                        form: { data: { turbo_confirm: "Retirer #{user.full_name} ?" }, class: "shrink-0" },
                        aria: { label: "Retirer #{user.full_name}" },
                        class: "inline-flex items-center gap-1 rounded-none px-2 py-1 text-xs font-semibold text-gray-500 hover:text-red-600 hover:bg-red-50" do %>
            <%= lucide_icon("x", class: "w-3.5 h-3.5", aria: { hidden: true }) %>
            Retirer
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% [ free, max_empty_slots ].min.times do |i| %>
    <% last_summary = i == max_empty_slots - 1 && free > max_empty_slots %>
    <div class="flex items-center gap-3 p-3 rounded-none border-2 border-dashed border-gray-200 text-gray-400">
      <span class="h-9 w-9 shrink-0 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center" aria-hidden="true">+</span>
      <span class="text-sm"><%= last_summary ? "+ #{free - max_empty_slots + 1} places libres" : "Place libre" %></span>
    </div>
  <% end %>
</div>

<% waitlisted = Sessions::WaitlistOrder.call(session: @session) %>
<% if waitlisted.any? %>
  <div class="mt-5">
    <h4 class="text-xs font-bold uppercase tracking-wide text-gray-900 mb-3 mt-3">Liste d’attente</h4>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    <% waitlisted.each_with_index do |registration, index| %>
      <% me = registration.user_id == current_user&.id %>
      <div class="flex items-center justify-between gap-3 p-3 rounded-none border <%= me ? "bg-orange-100 border-orange-500 text-orange-950" : "bg-orange-50 border-orange-200 text-orange-900" %>">
        <div class="flex items-center gap-2 min-w-0">
          <span class="inline-flex items-center justify-center w-6 h-6 text-xs font-bold bg-orange-200 text-orange-900 rounded-none shrink-0"><%= index + 1 %></span>
          <span class="font-medium text-sm truncate"><%= registration.user.full_name %><% if me %> <span class="font-semibold">· toi</span><% end %></span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-xs">En attente</span>
          <% can_remove = if Time.current <= @session.end_at
            current_user&.admin? || current_user == @session.user
          else
            current_user&.admin?
          end %>
          <% if can_remove %>
            <%= button_to session_registration_path(@session, calendar_ctx.merge(user_id: registration.user_id)), method: :delete,
                          form: { data: { turbo_confirm: "Retirer #{registration.user.full_name} de la liste d'attente ?" } },
                          class: "inline-flex items-center gap-1 rounded-none px-2 py-1 text-xs font-semibold text-white bg-red-600 hover:bg-red-500" do %>
              <%= lucide_icon("trash-2", class: "w-3 h-3", aria: { hidden: true }) %>
              Retirer
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# Inline add form moved to a side card on show page %>
