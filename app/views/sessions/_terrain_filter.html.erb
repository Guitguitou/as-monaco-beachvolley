<%# Variante :filter — l'état actif est porté par `aria-pressed`, que le calendrier
    déplace côté client lors d'un filtrage sans rechargement. Ne jamais leur
    appliquer :primary : les classes serveur resteraient collées à l'ancienne
    pastille active. `data-filter-pill` est le point d'accroche du JS. %>
<div id="terrain-tabs" class="flex gap-2 sm:gap-4 mb-4 sm:mb-6 overflow-x-auto whitespace-nowrap px-1"
     role="group" aria-label="Filtrer par terrain">
  <% all_terrains = ["", "Terrain 1", "Terrain 2", "Terrain 3"] %>
  <% query = { terrain: params[:terrain].presence, for_me: (ActiveModel::Type::Boolean.new.cast(params[:for_me]) ? "1" : nil), date: params[:date], view: params[:view].presence }.compact %>

  <% all_terrains.each do |terrain| %>
    <% label = terrain.presence || "Tous" %>
    <% active = params[:terrain].to_s == terrain.to_s %>
    <%= button(
      label,
      variant: :filter,
      size: :small,
      href: sessions_path(query.merge(terrain: terrain.presence)),
      data: { filter_pill: "terrain" },
      aria: { pressed: active.to_s }
    ) %>
  <% end %>
</div>

<% if (params[:view].presence || "calendar") != "grid" %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3 px-1 text-xs text-gray-500">
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-[#0052a3] border border-[#003d7a]"></span> Terrain 1
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-[#1a1a1a] border border-black"></span> Terrain 2
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-[#d4af37] border border-[#b08e2d]"></span> Terrain 3
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm border-l-2 border-l-[#e21e22] border border-gray-300 bg-white"></span> Session pour moi
    </span>
  </div>
<% end %>

<div id="audience-tabs" class="flex gap-2 sm:gap-4 mb-4 sm:mb-6 overflow-x-auto whitespace-nowrap px-1"
     role="group" aria-label="Filtrer par audience">
  <% audience_options = [
    { label: "Toutes les sessions", for_me: nil },
    { label: "Sessions pour moi", for_me: "1" }
  ] %>
  <% audience_query = { terrain: params[:terrain].presence, date: params[:date], view: params[:view].presence }.compact %>
  <% selected_for_me = ActiveModel::Type::Boolean.new.cast(params[:for_me]) ? "1" : nil %>

  <% audience_options.each do |option| %>
    <% active = selected_for_me.to_s == option[:for_me].to_s %>
    <%= button(
      option[:label],
      variant: :filter,
      size: :small,
      href: sessions_path(audience_query.merge(for_me: option[:for_me])),
      data: { filter_pill: "audience" },
      aria: { pressed: active.to_s }
    ) %>
  <% end %>
</div>
