<%# Retrait d'un joueur par le Staff après le délai d'annulation : le Staff
    choisit entre désinscription tardive et désinscription excusée (cf. GLOSSARY.md). %>
<% user = registration.user %>
<div data-controller="dialog" class="shrink-0">
  <button type="button" data-action="dialog#open" aria-label="Retirer <%= user.full_name %>"
          class="inline-flex items-center gap-1 rounded-none px-2 py-1 text-xs font-semibold text-gray-500 hover:text-red-600 hover:bg-red-50">
    <%= lucide_icon("x", class: "w-3.5 h-3.5", aria: { hidden: true }) %>
    Retirer
  </button>
  <%= render ModalComponent.new(title: "Retirer #{user.full_name} ?",
                                data: { dialog_target: "dialog", action: "click->dialog#backdropClose" }) do |modal| %>
    <%= render AlertComponent.new(tone: :warning, title: "Désinscription tardive") do %>
      Le délai d'annulation est dépassé : sans excuse, le joueur n'est pas remboursé et la désinscription est comptée.
    <% end %>
    <% modal.with_actions do %>
      <%= render ButtonComponent.new(href: session_registration_path(@session, calendar_ctx.merge(user_id: user.id)), method: :delete,
                                     size: :large, full_width: true) do %>
        Désinscription tardive
      <% end %>
      <%= render ButtonComponent.new(href: session_registration_path(@session, calendar_ctx.merge(user_id: user.id, excused: "1")), method: :delete,
                                     variant: :secondary, size: :large, full_width: true) do %>
        Excuser et rembourser
      <% end %>
      <button type="button" data-action="dialog#close" class="block w-full text-center text-sm text-gray-600 underline">
        Annuler
      </button>
    <% end %>
  <% end %>
</div>
