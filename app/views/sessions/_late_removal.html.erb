<%# Retrait d'un joueur par le Staff après le délai d'annulation : le Staff
    choisit entre désinscription tardive et désinscription excusée (cf. GLOSSARY.md). %>
<% user = registration.user %>
<div data-controller="dialog" class="shrink-0">
  <button type="button" data-action="dialog#open" aria-label="Retirer <%= user.full_name %>"
          class="inline-flex items-center gap-1 rounded-none px-2 py-1 text-xs font-semibold text-gray-500 hover:text-red-600 hover:bg-red-50">
    <%= lucide_icon("x", class: "w-3.5 h-3.5", aria: { hidden: true }) %>
    Retirer
  </button>
  <dialog data-dialog-target="dialog" data-action="click->dialog#backdropClose"
          class="m-auto w-[min(92vw,26rem)] rounded-none p-0 backdrop:bg-black/40">
    <div class="p-5 space-y-4 text-left">
      <h3 class="font-anton text-xl uppercase text-gray-900">Retirer <%= user.full_name %> ?</h3>
      <div class="rounded-none bg-orange-50 px-3 py-2.5 text-sm text-orange-900">
        <p class="font-semibold">Désinscription tardive</p>
        <p>Le délai d'annulation est dépassé : sans excuse, le joueur n'est pas remboursé et la désinscription est comptée.</p>
      </div>

      <%= button_to session_registration_path(@session, calendar_ctx.merge(user_id: user.id)), method: :delete,
                    class: "w-full inline-flex items-center justify-center gap-2 rounded-none bg-asmbv-red px-4 py-3 text-sm font-semibold text-white hover:bg-asmbv-red-dark" do %>
        Désinscription tardive
      <% end %>
      <%= button_to session_registration_path(@session, calendar_ctx.merge(user_id: user.id, excused: "1")), method: :delete,
                    class: "w-full inline-flex items-center justify-center gap-2 rounded-none border border-gray-300 bg-white px-4 py-3 text-sm font-semibold text-gray-900 hover:bg-gray-50" do %>
        Excuser et rembourser
      <% end %>
      <button type="button" data-action="dialog#close" class="block w-full text-center text-sm text-gray-600 underline">
        Annuler
      </button>
    </div>
  </dialog>
</div>
