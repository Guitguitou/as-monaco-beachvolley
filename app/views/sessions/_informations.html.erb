<%# Ne répète pas ce que le hero et la carte Participants disent déjà.
    Retirés : date et heure (pastilles du hero), terrain (hero), organisateur
    (carte Entraîneur), capacité (compteur de la carte Participants).
    Ne restent que les informations qui servent à décider. %>
<dl class="space-y-4 text-sm">
  <div class="flex items-start gap-3">
    <%= lucide_icon("clock", class: "w-5 h-5 text-gray-400 shrink-0 mt-0.5") %>
    <div class="min-w-0">
      <dt class="font-semibold text-gray-900">Durée</dt>
      <dd class="text-gray-600"><%= session_duration(@session.start_at, @session.end_at) %></dd>
    </div>
  </div>

  <div class="flex items-start gap-3">
    <%= lucide_icon("banknote-arrow-down", class: "w-5 h-5 text-gray-400 shrink-0 mt-0.5") %>
    <div class="min-w-0">
      <dt class="font-semibold text-gray-900">Coût</dt>
      <dd class="text-gray-600"><%= credits_label(@session.price) %></dd>
    </div>
  </div>

  <div class="flex items-start gap-3">
    <%= lucide_icon("layers", class: "w-5 h-5 text-gray-400 shrink-0 mt-0.5") %>
    <div class="min-w-0">
      <dt class="font-semibold text-gray-900">Niveau requis</dt>
      <dd class="text-gray-600">
        <% if @session.levels.any? %>
          <% if @session.entrainement? && @session.secondary_levels.any? %>
            <span class="font-medium text-gray-900"><%= session_levels_label(@session.priority_levels) %></span>
            <span class="ml-1 px-1.5 py-0.5 rounded-full bg-asmbv-red/10 text-asmbv-red text-[10px] font-semibold">prioritaire</span>
            <span class="block text-gray-500">puis <%= session_levels_label(@session.secondary_levels) %> (secondaire)</span>
          <% else %>
            <%= session_levels_label(@session.levels) %>
          <% end %>
        <% else %>
          Tous niveaux acceptés
        <% end %>
      </dd>
    </div>
  </div>

  <% if @session.entrainement? && @session.registration_opens_at.present? %>
    <div class="flex items-start gap-3">
      <%= lucide_icon("door-open", class: "w-5 h-5 text-gray-400 shrink-0 mt-0.5") %>
      <div class="min-w-0">
        <dt class="font-semibold text-gray-900">Ouverture des inscriptions</dt>
        <dd class="text-gray-600">
          <%= l @session.registration_opens_at, format: :default %>
          <% within_priority = Time.current < (@session.registration_opens_at + Session::PRIORITY_WINDOW_HOURS.hours) %>
          <% if Time.current < @session.registration_opens_at %>
            <span class="block mt-1"><%= render BadgeComponent.new(label: "Pas encore ouvert", variant: :neutral, size: :xs) %></span>
          <% elsif within_priority %>
            <span class="block mt-1"><%= render BadgeComponent.new(label: "Priorité compétition (24h)", variant: :info, size: :xs) %></span>
          <% end %>
        </dd>
      </div>
    </div>
  <% end %>

  <% if @session.entrainement? && @session.cancellation_deadline_at.present? %>
    <div class="flex items-start gap-3">
      <%= lucide_icon("alarm-clock", class: "w-5 h-5 text-gray-400 shrink-0 mt-0.5") %>
      <div class="min-w-0">
        <dt class="font-semibold text-gray-900">Limite de désinscription</dt>
        <dd class="text-gray-600">
          <%= l @session.cancellation_deadline_at, format: :default %>
          <span class="block mt-1">
            <% if Time.current > @session.cancellation_deadline_at %>
              <%= render BadgeComponent.new(label: "Délai dépassé", variant: :danger, size: :xs) %>
            <% else %>
              <%= render BadgeComponent.new(label: "Remboursement non garanti après", variant: :warning, size: :xs) %>
            <% end %>
          </span>
        </dd>
      </div>
    </div>
  <% end %>
</dl>
