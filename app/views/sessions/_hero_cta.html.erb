<%# locals: session: — action du joueur uniquement.
    Les actions d'administration (annuler la session, ajouter un inscrit) sont
    regroupées dans `_admin_actions` : une action destructive ne doit pas se
    trouver au contact du bouton d'inscription, à taille et forme identiques. %>
<% calendar_ctx = sessions_index_return_params %>
<% if user_signed_in? %>
  <% registration = Registration.new(user: current_user, session: session, status: :confirmed) %>
  <% can_register, reason = registration.can_register_with_reason %>
  <% waitlist_registration = Registration.new(user: current_user, session: session, status: :waitlisted) %>
  <% can_waitlist, waitlist_reason = waitlist_registration.can_register_with_reason %>
  <% existing_registration = current_user.registrations.find_by(session: session) %>
  <% weekly_secondary = Registrations::UserWeeklyPriorityMap.call(user: current_user, sessions: [ session ])[session.id] == Registrations::WeeklyPriorityRule::SECONDARY %>

  <% if existing_registration.nil? %>
    <%# Le 2e entraînement de la semaine n'est pas refusé : il est déclassé.
        On le dit avant le clic, sinon la démotion est incompréhensible. %>
    <% if weekly_secondary && (can_register || (session.full? && can_waitlist)) %>
      <div class="mb-3 border-l-4 border-orange-500 bg-orange-50 px-3 py-2 text-sm text-gray-700">
        Ce serait ton 2e entraînement de la semaine. Tu peux t'inscrire, mais tu passes après
        les joueurs qui n'en ont pas encore : si l'un d'eux s'inscrit et que la session est pleine,
        tu bascules en liste d'attente et tes crédits te sont rendus.
      </div>
    <% end %>
    <% if can_register %>
      <%= button_to session_registrations_path(session),
                    method: :post,
                    params: calendar_ctx,
                    class: "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-asmbv-red text-white hover:bg-asmbv-red-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-asmbv-red" do %>
        <%= lucide_icon("check-circle", class: "size-5", aria: { hidden: true }) %>
        <span>Je m'inscris</span>
      <% end %>
    <% elsif session.full? %>
      <%= button_to session_registrations_path(session),
                    method: :post,
                    params: calendar_ctx.merge(waitlist: true),
                    disabled: !can_waitlist,
                    class: "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold " +
                          (can_waitlist ? "bg-gray-900 text-white hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900" : "bg-gray-100 text-gray-500 border border-gray-200 cursor-not-allowed") do %>
        <%= lucide_icon("clock", class: "size-5", aria: { hidden: true }) %>
        <span><%= can_waitlist ? "Rejoindre la liste d'attente" : waitlist_reason %></span>
      <% end %>
    <% else %>
      <div class="w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-gray-100 text-gray-500 border border-gray-200"
           aria-disabled="true">
        <%= lucide_icon("lock", class: "size-5 shrink-0", aria: { hidden: true }) %>
        <span><%= reason %></span>
      </div>
    <% end %>
  <% else %>
    <% can_self_unsubscribe = Time.current <= session.end_at || current_user.admin? %>
    <% if can_self_unsubscribe %>
      <%= button_to session_registration_path(session, calendar_ctx.merge(id: "current")), method: :delete,
                    class: "w-full inline-flex items-center justify-center gap-2 rounded-none border border-asmbv-red bg-white px-4 py-3 text-sm font-semibold text-asmbv-red hover:bg-asmbv-red/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-asmbv-red" do %>
        <%= lucide_icon("x-circle", class: "size-5", aria: { hidden: true }) %>
        <span><%= existing_registration.waitlisted? ? "Quitter la liste d'attente" : "Je me désinscris" %></span>
      <% end %>
    <% end %>

    <% unless existing_registration.waitlisted? %>
      <div class="mt-3">
        <%= render AddToCalendarComponent.new(
              url: calendar_session_path(session, format: :ics),
              google_url: Calendar::GoogleUrl.call(Sessions::CalendarEvent.call(session, url: session_url(session)))
            ) %>
      </div>
    <% end %>

    <% if !existing_registration.waitlisted? && session.entrainement? && session.cancellation_deadline_at.present? %>
      <div class="mt-3">
        <% if Time.current > session.cancellation_deadline_at %>
          <%= render BadgeComponent.new(label: "Aucun remboursement automatique (délai dépassé)", variant: :warning, size: :sm) %>
        <% else %>
          <%= render BadgeComponent.new(label: "Remboursement auto si désinscription avant #{l(session.cancellation_deadline_at, format: :long)}", variant: :neutral, size: :sm) %>
        <% end %>
      </div>
    <% end %>

    <% if weekly_secondary %>
      <div class="mt-3">
        <%= render BadgeComponent.new(label: "Non prioritaire cette semaine", variant: :warning, size: :sm) %>
      </div>
    <% end %>

    <% if existing_registration.waitlisted? %>
      <%# Position dans l'ordre réel de promotion, pas dans l'ordre d'arrivée. %>
      <% waitlisted_ids = Sessions::WaitlistOrder.call(session: session).map(&:user_id) %>
      <% my_index = waitlisted_ids.index(current_user.id) %>
      <% if my_index %>
        <div class="mt-3">
          <%= render BadgeComponent.new(label: "Position estimée : ##{my_index + 1}", variant: :warning, size: :sm) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="text-sm font-semibold text-gray-900">Connecte-toi pour t'inscrire.</div>
  <div class="mt-3">
    <%= link_to new_user_session_path, class: "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-asmbv-red text-white hover:bg-asmbv-red-dark" do %>
      <%= lucide_icon("log-in", class: "size-5") %>
      Se connecter
    <% end %>
  </div>
<% end %>
