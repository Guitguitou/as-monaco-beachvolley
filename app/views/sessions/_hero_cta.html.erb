<%# locals: session: — action du joueur uniquement.
    Les actions d'administration (annuler la session, ajouter un inscrit) sont
    regroupées dans `_admin_actions` : une action destructive ne doit pas se
    trouver au contact du bouton d'inscription, à taille et forme identiques.

    Un état par situation (cf. Sessions::CtaState) : le joueur voit ce qui se
    passe au clic, ce que ça coûte et, quand c'est bloqué, ce qui débloque. %>
<% calendar_ctx = sessions_index_return_params %>
<% primary = "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-brand text-white hover:bg-brand-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand" %>
<% dark = "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-gray-900 text-white hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900" %>
<% ghost = "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold border border-gray-300 bg-white text-gray-900 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900" %>
<% locked = "w-full inline-flex items-center justify-center gap-2 rounded-none px-4 py-3 text-sm font-semibold bg-gray-100 text-gray-500 border border-gray-200" %>
<% hint = "mt-2 text-center text-xs text-gray-600" %>

<% if user_signed_in? %>
  <% cta = Sessions::CtaState.new(session: session, user: current_user) %>

  <% case cta.kind %>
  <% when :open, :waitlist %>
    <%# Le 2e entraînement de la semaine n'est pas refusé : il est déclassé.
        Une ligne visible avant le clic, le détail se déplie. %>
    <% if cta.weekly_secondary? %>
      <details class="mb-3 border-l-4 border-orange-500 bg-orange-50 px-3 py-2 text-sm text-gray-700">
        <summary class="cursor-pointer font-semibold text-gray-900">Ce serait ton 2e entraînement de la semaine</summary>
        <p class="mt-1">Tu passes après les joueurs qui n'en ont pas encore : si l'un d'eux s'inscrit et que la session est pleine, tu bascules en liste d'attente et ton crédit t'est rendu.</p>
      </details>
    <% end %>

    <% if cta.kind == :open %>
      <%= button_to session_registrations_path(session), method: :post, params: calendar_ctx, class: primary do %>
        <%= lucide_icon("check-circle", class: "size-5", aria: { hidden: true }) %>
        <span><%= cta.weekly_secondary? ? "Je m'inscris quand même" : "Je m'inscris" %></span>
      <% end %>
      <% if cta.cost.positive? %>
        <p class="<%= hint %>">
          <%= credits_label(cta.cost) %> · il t'en restera <%= cta.balance_after %>
          <% if cta.refund_deadline %>
            · remboursé si tu annules avant <%= l(cta.refund_deadline, format: :short) %>
          <% end %>
        </p>
      <% end %>
    <% else %>
      <%= button_to session_registrations_path(session), method: :post, params: calendar_ctx.merge(waitlist: true), class: dark do %>
        <%= lucide_icon("clock", class: "size-5", aria: { hidden: true }) %>
        <span>Rejoindre la liste d'attente</span>
      <% end %>
      <p class="<%= hint %>">
        Tu serais <strong>#<%= cta.waitlist_position %></strong> · aucun crédit débité tant que tu n'as pas de place
      </p>
    <% end %>

  <% when :not_yet_open %>
    <div class="<%= locked %>" aria-disabled="true">
      <%= lucide_icon("clock", class: "size-5 shrink-0", aria: { hidden: true }) %>
      <span>Ouverture dans <%= time_until(cta.opens_at) %></span>
    </div>
    <p class="<%= hint %>"><%= cta.reason %></p>

  <% when :no_credits %>
    <div class="<%= locked %>" aria-disabled="true">
      <%= lucide_icon("lock", class: "size-5 shrink-0", aria: { hidden: true }) %>
      <span>Il te manque <%= credits_label(cta.missing_credits) %></span>
    </div>
    <%= link_to packs_path, class: "#{primary} mt-2" do %>
      <%= lucide_icon("shopping-cart", class: "size-5", aria: { hidden: true }) %>
      <span>Acheter des crédits</span>
    <% end %>

  <% when :wrong_level %>
    <div class="<%= locked %>" aria-disabled="true">
      <%= lucide_icon("lock", class: "size-5 shrink-0", aria: { hidden: true }) %>
      <span>Réservé aux niveaux <%= session_levels_label(session.levels) %></span>
    </div>
    <p class="<%= hint %>">
      <%= link_to "Voir les sessions de mon niveau", sessions_path(calendar_ctx.merge(for_me: "1")), class: "underline hover:text-gray-900" %>
    </p>

  <% when :blocked %>
    <div class="<%= locked %>" aria-disabled="true">
      <%= lucide_icon("lock", class: "size-5 shrink-0", aria: { hidden: true }) %>
      <span><%= cta.reason %></span>
    </div>

  <% when :registered, :waitlisted %>
    <div class="flex items-center justify-between gap-3">
      <% if cta.kind == :registered %>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-green-700">
          <%= lucide_icon("check-circle", class: "size-5", aria: { hidden: true }) %> Tu es inscrit
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-orange-700">
          <%= lucide_icon("clock", class: "size-5", aria: { hidden: true }) %> En liste d'attente · #<%= cta.waitlist_position %>
        </span>
      <% end %>

      <% if cta.can_unsubscribe? %>
        <%# Se désinscrire passe en lien secondaire ; la confirmation annonce ce
            qu'il advient du crédit plutôt que de demander « es-tu sûr ? ». %>
        <div data-controller="dialog">
          <button type="button" data-action="dialog#open"
                  class="text-sm text-gray-500 underline hover:text-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand">
            <%= cta.kind == :waitlisted ? "Quitter la liste" : "Se désinscrire" %>
          </button>
          <dialog data-dialog-target="dialog" data-action="click->dialog#backdropClose"
                  class="m-auto w-[min(92vw,26rem)] rounded-none p-0 backdrop:bg-black/40">
            <div class="p-5 space-y-4 text-left">
              <h3 class="font-anton text-xl uppercase text-gray-900">
                <%= cta.kind == :waitlisted ? "Quitter la liste d'attente ?" : "Te désinscrire ?" %>
              </h3>
              <% if cta.kind == :waitlisted %>
                <p class="text-sm text-gray-700">Tu perds ta place #<%= cta.waitlist_position %>. Aucun crédit n'a été débité.</p>
              <% elsif cta.cost.zero? %>
                <p class="text-sm text-gray-700">Ta place est rendue aux joueurs en attente.</p>
              <% elsif cta.refundable_now? %>
                <div class="rounded-none bg-green-50 px-3 py-2.5 text-sm text-green-800">
                  <p class="font-semibold">Ton crédit te sera rendu</p>
                  <% if cta.refund_deadline %>
                    <p>Tu annules avant le <%= l(cta.refund_deadline, format: :long) %>.</p>
                  <% end %>
                </div>
              <% else %>
                <div class="rounded-none bg-orange-50 px-3 py-2.5 text-sm text-orange-900">
                  <p class="font-semibold">Ton crédit ne sera pas rendu</p>
                  <p>Le délai de remboursement est dépassé.</p>
                </div>
              <% end %>

              <%= button_to session_registration_path(session, calendar_ctx.merge(id: "current")), method: :delete,
                            class: "w-full inline-flex items-center justify-center gap-2 rounded-none border border-brand bg-white px-4 py-3 text-sm font-semibold text-brand hover:bg-brand/5" do %>
                <%= lucide_icon("x-circle", class: "size-5", aria: { hidden: true }) %>
                <span>
                  <% if cta.kind == :waitlisted %>
                    Quitter la liste d'attente
                  <% elsif cta.cost.positive? && !cta.refundable_now? %>
                    Me désinscrire sans remboursement
                  <% else %>
                    Me désinscrire
                  <% end %>
                </span>
              <% end %>
              <button type="button" data-action="dialog#close" class="block w-full text-center text-sm text-gray-600 underline">
                Garder ma place
              </button>
            </div>
          </dialog>
        </div>
      <% end %>
    </div>

    <% if cta.kind == :waitlisted %>
      <p class="<%= hint %>">
        Si une place se libère, tu es inscrit automatiquement et prévenu par notification<%= cta.cost.positive? ? " ; #{credits_label(cta.cost)} débité à ce moment" : "" %>.
      </p>
    <% end %>

    <% if cta.kind == :registered %>
      <div class="mt-3">
        <%= render AddToCalendarComponent.new(
              url: calendar_session_path(session, format: :ics),
              google_url: Calendar::GoogleUrl.call(Sessions::CalendarEvent.call(session, url: session_url(session)))
            ) %>
      </div>
      <% if cta.refund_deadline && cta.cost.positive? %>
        <p class="<%= hint %>">
          <% if cta.refundable_now? %>
            Crédit rendu si tu annules avant le <%= l(cta.refund_deadline, format: :short) %>
            (dans <%= time_until(cta.refund_deadline) %>)
          <% else %>
            Délai de remboursement dépassé
          <% end %>
        </p>
      <% end %>
      <% if cta.weekly_secondary? %>
        <div class="mt-3">
          <%= render BadgeComponent.new(label: "Non prioritaire cette semaine", variant: :warning, size: :sm) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="text-sm font-semibold text-gray-900">Connecte-toi pour t'inscrire.</div>
  <div class="mt-3">
    <%= link_to new_user_session_path, class: primary do %>
      <%= lucide_icon("log-in", class: "size-5") %>
      Se connecter
    <% end %>
  </div>
<% end %>
