<% registered_sessions = Array(@sessions_registered_grid) %>
<% eligible_sessions = Array(@sessions_eligible_grid) %>

<% if registered_sessions.empty? && eligible_sessions.empty? %>
  <%= render CardComponent.new(padding: :lg, class_name: "mt-6 text-center") do %>
    <p class="text-sm text-gray-500">Aucune session à venir.</p>
  <% end %>
<% else %>
  <% conflict_ids = Array(@conflict_session_ids).map(&:to_i).to_set %>
  <% regs = @registrations_by_session_id || {} %>
  <% counts = @confirmed_counts_by_session_id || {} %>
  <% user_level_ids = Array(@user_level_ids).map(&:to_i) %>
  <% user_balance = @user_balance_amount.to_i %>
  <% return_params = sessions_index_return_params %>

  <%# Construit l'état d'une carte à partir des données déjà préchargées par le
      contrôleur — aucune requête supplémentaire par session. %>
  <% card_state = lambda do |session|
       Sessions::CardState.new(
         session: session,
         user: current_user,
         registration: regs[session.id],
         confirmed_count: counts[session.id].to_i,
         conflict: conflict_ids.include?(session.id),
         balance: user_balance,
         user_level_ids: user_level_ids
       )
     end %>

  <% if registered_sessions.any? %>
    <section class="mt-6">
      <h2 class="font-anton text-xl uppercase tracking-tight text-gray-900">Mes prochaines sessions</h2>
      <p class="mt-1 text-sm text-gray-600">Où tu es inscrit ou en liste d'attente.</p>

      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% registered_sessions.each do |session| %>
          <%= render SessionCardComponent.new(state: card_state.call(session), return_params: return_params) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if eligible_sessions.any? %>
    <section class="<%= registered_sessions.any? ? 'mt-12' : 'mt-6' %>">
      <h2 class="font-anton text-xl uppercase tracking-tight text-gray-900">Sessions ouvertes</h2>

      <%# Séparateurs de jour : sans eux, quatre tournois identiques se suivent
          sans aucun repère temporel. %>
      <% eligible_sessions.group_by { |s| s.start_at.to_date }.each do |day, day_sessions| %>
        <div class="mt-8 flex items-center gap-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 shrink-0">
            <%= l(day, format: :day_and_month) %>
          </h3>
          <span class="flex-1 border-t border-gray-200"></span>
          <span class="text-xs text-gray-400 shrink-0"><%= day_sessions.size %></span>
        </div>

        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% day_sessions.each do |session| %>
            <%= render SessionCardComponent.new(state: card_state.call(session), return_params: return_params) %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
