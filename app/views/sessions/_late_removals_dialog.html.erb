<%# Participants dont le retrait serait une désinscription tardive : le Staff
    coche ceux qu'il excuse avant d'enregistrer (cf. late_removal_controller). %>
<% late = session.registrations.confirmed.includes(:user).select { |registration| Registrations::Cancellation.new(registration).late? } %>
<dialog data-late-removal-target="dialog" class="m-auto w-[min(92vw,28rem)] rounded-none p-0 backdrop:bg-black/40">
  <div class="p-5 space-y-4 text-left">
    <h3 class="font-anton text-xl uppercase text-gray-900">Désinscriptions tardives</h3>
    <p class="text-sm text-gray-700">
      Le délai d'annulation est dépassé : sans excuse, ces joueurs ne sont pas remboursés et la désinscription est comptée.
      Coche ceux que tu excuses.
    </p>
    <ul class="space-y-2">
      <% late.each do |registration| %>
        <li data-late-removal-target="row" data-user-id="<%= registration.user_id %>" hidden>
          <label class="flex items-center gap-3 border border-gray-200 px-3 py-2 text-sm text-gray-900">
            <input type="checkbox" name="session[excused_ids][]" value="<%= registration.user_id %>" disabled
                   class="rounded-none border-gray-300 text-brand focus:ring-brand">
            <span class="flex-1"><%= registration.user.full_name %></span>
            <span class="text-xs text-gray-500">Excuser et rembourser</span>
          </label>
        </li>
      <% end %>
    </ul>
    <button type="button" data-action="late-removal#submit"
            class="w-full rounded-none bg-brand px-4 py-3 text-sm font-semibold text-white hover:bg-brand-dark">
      Confirmer et enregistrer
    </button>
    <button type="button" data-action="late-removal#cancel" class="block w-full text-center text-sm text-gray-600 underline">
      Annuler
    </button>
  </div>
</dialog>
