<% is_admin_or_owner = current_user&.admin? || current_user == @session.user %>
<% confirmed_count = @session.registrations.loaded? ? @session.registrations.count(&:confirmed?) : @session.registrations.confirmed.count %>
<% accent = Sessions::CardState::ACCENTS[@session.session_type] %>

<% content_for :hero do %>
  <%= render HeroComponent.new(
        title: (@session.title.presence || @session.display_name),
        variant: :red,
        flush_title: true,
        title_font: :anton
      ) do |hero| %>
    <% hero.with_top do %>
      <%= render "hero_top", session: @session %>
    <% end %>
    <% hero.with_eyebrow do %>
      <%= render BadgeComponent.new(
            label: get_session_type_label(@session.session_type),
            variant: :hero_inverse,
            icon: session_type_icon(@session.session_type),
            size: :md
          ) %>
    <% end %>
    <% hero.with_meta do %>
      <%= render "hero_meta", session: @session %>
    <% end %>
  <% end %>
<% end %>

<%# pb-24 sur mobile : laisse la place à la barre d'action collée en bas %>
<div class="max-w-6xl mx-auto px-4 py-8 pb-28 lg:pb-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
    <div class="lg:col-span-2 min-w-0 space-y-6">
      <% if @session.description.present? %>
        <%= render CardComponent.new(padding: :lg) do |card| %>
          <% card.with_header do %>
            <h3 class="font-bebas-neue text-xl tracking-wider uppercase text-gray-900">Description</h3>
          <% end %>
          <div class="prose prose-sm max-w-none text-gray-800">
            <%= simple_format(@session.description) %>
          </div>
        <% end %>
      <% end %>

      <%= render CardComponent.new(padding: :lg) do |card| %>
        <% card.with_header do %>
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <h3 class="font-bebas-neue text-xl tracking-wider uppercase text-gray-900">
              <% if @session.max_players.present? %>
                Participants (<%= confirmed_count %>/<%= @session.max_players %>)
              <% else %>
                Participants
              <% end %>
            </h3>
            <% if (label = spots_left_label(confirmed_count, @session.max_players)) %>
              <%= render BadgeComponent.new(
                    label: label,
                    variant: label == "Complet" ? :destructive : :success,
                    size: :sm
                  ) %>
            <% end %>
          </div>
        <% end %>

        <%# L'encadrant, en une ligne : sa propre carte doublonnait avec la ligne
            « Organisateur » du bloc Informations. %>
        <% if @session.user %>
          <div class="mb-4 flex items-center gap-3 border-b border-gray-100 pb-4">
            <%= render AvatarComponent.new(user: @session.user, size: :md) %>
            <div class="min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-wide text-gray-500">
                <%= @session.entrainement? || @session.coaching_prive? ? "Entraîneur" : "Responsable" %>
              </p>
              <p class="font-semibold text-gray-900 truncate"><%= @session.user.full_name %></p>
            </div>
          </div>
        <% end %>

        <% if @session.max_players.present? %>
          <div class="mb-4">
            <%= render ProgressBarComponent.new(value: confirmed_count, max: @session.max_players, variant: accent || :primary, height: :sm) %>
          </div>
        <% end %>

        <%= render "participants" %>
      <% end %>

      <% if user_signed_in? && @session.entrainement? && is_admin_or_owner %>
        <%= render CardComponent.new(padding: :lg) do |card| %>
          <% card.with_header do %>
            <h3 class="font-bebas-neue text-xl tracking-wider uppercase text-gray-900">Notes entraîneur</h3>
          <% end %>
          <div class="mb-3 text-sm text-gray-600">Thème, retours, informations utiles (visible uniquement par les coachs et admins)</div>
          <%= form_with model: @session, url: session_path(@session), method: :put, local: true do |f| %>
            <%= render FormFieldComponent.new(
              form: f,
              attribute: :coach_notes,
              type: :text_area,
              label: "Notes entraîneur",
              show_label: false,
              html_options: { rows: 6 }
            ) %>
            <div class="mt-3 flex items-center gap-2">
              <%= f.submit "Enregistrer les notes",
                  class: "inline-flex items-center justify-center gap-2 font-semibold rounded-lg bg-gray-100 border border-gray-200 text-gray-900 hover:bg-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-asmbv-red px-3 py-2 text-sm" %>
              <% if @session.coach_notes.present? %>
                <span class="text-xs text-gray-500">Dernière mise à jour : <%= l(@session.updated_at, format: :short) %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% elsif user_signed_in? && @session.entrainement? && (current_user.admin? || current_user.coach?) && @session.coach_notes.present? %>
        <%= render CardComponent.new(padding: :lg) do |card| %>
          <% card.with_header do %>
            <h3 class="font-bebas-neue text-xl tracking-wider uppercase text-gray-900">Notes entraîneur</h3>
          <% end %>
          <div class="prose prose-sm max-w-none whitespace-pre-line text-gray-800"><%= @session.coach_notes %></div>
        <% end %>
      <% end %>
    </div>

    <div class="lg:col-span-1 min-w-0 space-y-6">
      <%# Sur desktop, l'action reste dans la colonne collante ; sur mobile elle
          est rendue dans la barre du bas, en fin de page. %>
      <div class="hidden lg:block">
        <%= render CardComponent.new(padding: :lg, class_name: "border-2 border-asmbv-red/20 lg:sticky lg:top-20 lg:self-start") do %>
          <%= render "hero_cta", session: @session %>
        <% end %>
      </div>

      <%= render CardComponent.new(padding: :lg) do |card| %>
        <% card.with_header do %>
          <h3 class="font-bebas-neue text-sm tracking-wider uppercase text-gray-600">Informations</h3>
        <% end %>
        <%= render "informations" %>
      <% end %>

      <% if is_admin_or_owner %>
        <%= render "admin_actions", session: @session %>
      <% end %>
    </div>
  </div>
</div>

<%# Barre d'action collée en bas, mobile uniquement : le CTA était à 1,12 écran
    sous le pli. Le même partiel qu'en colonne desktop, présenté autrement.
    Le drapeau `sticky_action_bar` dit au layout de masquer la barre de
    navigation basse, pour ne pas empiler deux barres. %>
<% content_for :sticky_action_bar, true %>
<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-gray-200 bg-white/95 backdrop-blur px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-2px_8px_rgba(0,0,0,0.06)]">
  <%= render "hero_cta", session: @session %>
</div>
