<%# locals: session: %>
<div class="flex flex-wrap gap-2">
  <span class="inline-flex items-center gap-2 rounded-none border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
    <%= lucide_icon("calendar", class: "w-4 h-4 shrink-0 text-gray-400") %>
    <span class="first-letter:uppercase"><%= l(session.start_at.to_date, format: :long) %></span>
  </span>
  <span class="inline-flex items-center gap-2 rounded-none border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
    <%= lucide_icon("clock", class: "w-4 h-4 shrink-0 text-gray-400") %>
    <%= l(session.start_at, format: :time) %> – <%= l(session.end_at, format: :time) %>
  </span>
  <span class="inline-flex items-center gap-2 rounded-none border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
    <%= lucide_icon("map-pin", class: "w-4 h-4 shrink-0 text-gray-400") %>
    <%= session.terrain.to_s.split("_").last %>
  </span>
</div>
