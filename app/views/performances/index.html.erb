<% content_for :hero do %>
  <%= render PageHeaderComponent.new(title: "Performances & stats",
                                     subtitle: "Qui squatte le sable ? Les podiums du club, par groupe et par période.") %>
<% end %>

<% podium_keys = %i[all_time free_play_week free_play_month training_week training_month inactivity] %>

<div class="max-w-6xl mx-auto" data-controller="switch">
  <%# Portée : tout le club ou un groupe. Défile horizontalement sur mobile. %>
  <div role="tablist" aria-label="Groupe" class="-mx-4 px-4 sm:mx-0 sm:px-0 flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none]">
    <% scope_chip = "group shrink-0 inline-flex items-center gap-2 rounded-none border px-3 py-2 text-sm font-semibold transition-colors " \
                    "border-gray-200 bg-white text-gray-600 hover:border-gray-300 hover:text-gray-900 " \
                    "aria-selected:border-(--chip) aria-selected:bg-(--chip) aria-selected:text-white" %>
    <button type="button" role="tab" aria-selected="true" data-switch-target="option" data-key="club" data-action="switch#select"
            class="<%= scope_chip %>" style="--chip: var(--color-asmbv-ink)">
      <%= lucide_icon("users", class: "w-4 h-4", aria: { hidden: true }) %>
      Tout le club
    </button>
    <% @stats_by_group.each do |level_id, group_stats| %>
      <button type="button" role="tab" aria-selected="false" data-switch-target="option" data-key="level-<%= level_id %>" data-action="switch#select"
              class="<%= scope_chip %>" style="--chip: <%= group_stats[:level].color %>">
        <span class="h-2.5 w-2.5 rounded-full bg-(--chip) group-aria-selected:bg-white"></span>
        <%= group_stats[:level_name] %>
      </button>
    <% end %>
  </div>

  <%# Tout le club, un genre à la fois. %>
  <%# Le sélecteur de genre vit dans une div : posé sur la section elle-même, il
      soustrairait la cible `panel` au contrôleur parent. %>
  <section data-switch-target="panel" data-key="club" class="mt-4">
    <div data-controller="switch">
      <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
        <%= render SectionHeaderComponent.new(title: "Tout le club", subtitle: "Tous types de sessions confondus.") %>
        <%= render SegmentedControlComponent.new(label: "Genre", options: [
              { key: "male", label: "Hommes" }, { key: "female", label: "Femmes" }
            ]) %>
      </div>

      <% { male: "Porté disparu", female: "Portée disparue" }.each_with_index do |(gender, frigo_title), index| %>
        <div data-switch-target="panel" data-key="<%= gender %>" <%= "hidden" unless index.zero? %>>
          <%= render "leaderboards", players: podium_keys.index_with { |key| @stats[key][gender] }, frigo_title: frigo_title %>
        </div>
      <% end %>
    </div>
  </section>

  <%# Un panneau par groupe : podiums puis classement complet. %>
  <% @stats_by_group.each do |level_id, group_stats| %>
    <section data-switch-target="panel" data-key="level-<%= level_id %>" hidden class="mt-4 space-y-8">
      <div>
        <div class="mb-4">
          <%= render SectionHeaderComponent.new(title: group_stats[:level_name], subtitle: "Les podiums du groupe.") %>
        </div>
        <%= render "leaderboards", players: podium_keys.index_with { |key| group_stats[key][:players] }, frigo_title: "Porté(e) disparu(e)" %>
      </div>

      <div data-controller="switch">
        <%= render CardComponent.new do %>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <%= render SectionHeaderComponent.new(title: "Classement complet", subtitle: "Toutes les sessions depuis le début.") %>
            <%= render SegmentedControlComponent.new(label: "Type de session", options: [
                  { key: "all", label: "Général", icon: "trophy" },
                  { key: "free_play", label: "Jeu libre", icon: "activity" },
                  { key: "training", label: "Entraînement", icon: "graduation-cap" }
                ]) %>
          </div>

          <% { all: :all_time, free_play: :free_play_total, training: :training_total }.each_with_index do |(key, stat), index| %>
            <div data-switch-target="panel" data-key="<%= key %>" class="mt-4" <%= "hidden" unless index.zero? %>>
              <%= render RankingComponent.new(players: group_stats[stat][:full_ranking], current_user_id: current_user.id) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
