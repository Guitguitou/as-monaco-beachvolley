<div class="max-w-6xl mx-auto">
  <%# Titre porté par le PageHeaderComponent du layout. %>

  <%= turbo_frame_tag "me_sessions" do %>
    <%= tab_bar([
          { label: "À venir", href: me_sessions_path(filter: "upcoming"),
            active: @list.upcoming?, icon: "calendar-clock",
            count: (@list.upcoming_count if @list.upcoming_count.positive?) },
          { label: "Passées", href: me_sessions_path(filter: "past"),
            active: !@list.upcoming?, icon: "calendar-check",
            count: (@list.past_count if @list.past_count.positive?) }
        ], turbo_frame: "me_sessions") %>

    <%# Une inscription en liste d'attente n'était signalée nulle part. %>
    <% if @list.upcoming? && @list.waitlisted_count.positive? %>
      <p class="mt-4 inline-flex items-center gap-2 border-l-4 border-orange-500 bg-orange-50 px-4 py-2 text-sm text-gray-700">
        <%= lucide_icon("clock-alert", class: "w-4 h-4 shrink-0 text-orange-500", aria: { hidden: true }) %>
        Tu es en liste d'attente sur
        <%= fr_pluralize(@list.waitlisted_count, "session", "sessions") %>.
      </p>
    <% end %>

    <div class="mt-6">
      <% if @list.registrations.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @list.registrations.each do |registration| %>
            <%= render SessionCardComponent.new(state: @list.card_state_for(registration)) %>
          <% end %>
        </div>
      <% elsif @list.upcoming? %>
        <%= render EmptyStateComponent.new(
              icon: "calendar-x",
              title: "Rien de prévu",
              description: "Tu n'es inscrit à aucune session à venir."
            ) do |empty| %>
          <% empty.with_action do %>
            <%= button("Voir les sessions ouvertes", variant: :primary, size: :medium,
                       href: sessions_path(view: "grid"), data: { turbo_frame: "_top" }) %>
          <% end %>
        <% end %>
      <% else %>
        <%= render EmptyStateComponent.new(
              icon: "history",
              title: "Aucune session passée",
              description: "Tes sessions jouées apparaîtront ici."
            ) %>
      <% end %>
    </div>
  <% end %>
</div>
