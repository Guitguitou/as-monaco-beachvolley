<%= form_with model: campaign, url: (campaign.persisted? ? admin_shop_campaign_path(campaign) : admin_shop_campaigns_path), scope: :shop_campaign,
              class: "space-y-6 bg-white p-6 rounded-none shadow-md" do |f| %>
  <%= render "shared/form_errors", object: campaign %>

  <%= render FormFieldComponent.new(form: f, attribute: :name, label: "Nom de la campagne", required: true,
        html_options: { placeholder: "Ex : Commande groupée 2026-2027" }) %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <%= render FormFieldComponent.new(form: f, attribute: :opens_on, type: :date_field, label: "Ouverture", required: true) %>
    <%= render FormFieldComponent.new(form: f, attribute: :closes_on, type: :date_field, label: "Clôture", required: true) %>
    <%= render FormFieldComponent.new(form: f, attribute: :status, type: :select, label: "Statut",
          options: [ [ "Brouillon", "draft" ], [ "Ouverte", "open" ], [ "Clôturée", "closed" ] ], select_options: { include_blank: false }) %>
  </div>
  <p class="-mt-3 text-xs text-gray-500">
    En brouillon, la boutique est invisible. Ouverte, les membres commandent entre l'ouverture et la clôture, dates comprises :
    passé la clôture, plus aucune commande n'est possible.
  </p>

  <div>
    <%= render FormFieldComponent.new(form: f, attribute: :welcome_message, type: :text_area, label: "Message en haut de la boutique",
          html_options: { rows: 3, placeholder: "Ex : Commande groupée Joma et Nine. Le total est calculé pour toi, tu paies en ligne en une fois." }) %>
  </div>

  <div class="flex items-start gap-2">
    <%= f.check_box :allow_edits, class: "mt-0.5 rounded-none border-gray-300 text-brand focus:ring-brand" %>
    <div>
      <%= f.label :allow_edits, "Modification possible jusqu'à la clôture", class: "text-sm font-medium text-gray-900" %>
      <p class="text-xs text-gray-500">Le membre peut changer une taille ou un coloris sur une commande payée, à prix égal.</p>
    </div>
  </div>

  <%= render ButtonComponent.new(type: :submit) do %>
    <%= lucide_icon("save", size: 16) %> Enregistrer
  <% end %>
<% end %>
