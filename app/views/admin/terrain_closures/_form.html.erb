<%= form_with model: [:admin, terrain_closure], class: "space-y-6 max-w-md bg-white p-6 rounded-none shadow-md" do |f| %>
  <%= render "shared/form_errors", object: terrain_closure %>

  <div>
    <%= render FormFieldComponent.new(
      form: f,
      attribute: :terrain,
      type: :select,
      label: "Terrain",
      required: true,
      select_options: { include_blank: false },
      options: options_for_select(TerrainClosure::ALLOWED_TERRAINS, terrain_closure.terrain)
    ) %>
  </div>

  <div>
    <%= render FormFieldComponent.new(
      form: f,
      attribute: :starts_on,
      type: :date_field,
      label: "Du (inclus)",
      required: true
    ) %>
  </div>

  <div>
    <%= render FormFieldComponent.new(
      form: f,
      attribute: :ends_on,
      type: :date_field,
      label: "Au (inclus)",
      required: true
    ) %>
  </div>

  <div>
    <%= render FormFieldComponent.new(
      form: f,
      attribute: :reason,
      type: :text_area,
      label: "Motif (optionnel)",
      html_options: { rows: 2 }
    ) %>
  </div>

  <div>
    <%= render ButtonComponent.new(type: :submit, class: "w-full") do %>
      <%= lucide_icon("save", size: 16) %> Enregistrer
    <% end %>
  </div>
<% end %>
