<%= render Admin::ConfigurationTabsComponent.new(active: :integrations) %>

<div class="mb-6">
  <h2 class="text-lg font-semibold flex items-center gap-2 text-gray-900">
    <%= lucide_icon("bot") %> Connexions Claude
  </h2>
  <p class="text-sm text-gray-500 mt-1">
    Membres du Staff ayant connecté leur Claude au club. Une connexion inutilisée pendant 30 jours est coupée automatiquement.
  </p>
</div>

<%= render CardComponent.new(padding: :none, class_name: "overflow-hidden") do %>
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-left text-gray-600">
      <tr>
        <th class="px-4 py-2 font-medium">Membre</th>
        <th class="px-4 py-2 font-medium">Connecté le</th>
        <th class="px-4 py-2 font-medium">Dernière utilisation</th>
        <th class="px-4 py-2 font-medium">Droits</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @connections.each do |connection| %>
        <tr>
          <td class="px-4 py-2 text-gray-800"><%= connection.user.full_name %></td>
          <td class="px-4 py-2 text-gray-600"><%= connection.connected_at && l(connection.connected_at, format: :short) %></td>
          <td class="px-4 py-2 text-gray-600"><%= l(connection.last_used_at, format: :short) %></td>
          <td class="px-4 py-2 text-gray-600"><%= connection.scopes.include?("write") ? "Lecture et écriture" : "Lecture" %></td>
          <td class="px-4 py-2 text-right">
            <%= button_to admin_claude_connection_path(connection.user),
                  method: :delete,
                  class: "inline-flex items-center gap-1 rounded-none border border-brand px-3 py-1 text-xs font-semibold text-brand hover:bg-brand hover:text-white transition-colors",
                  data: { turbo_confirm: "Révoquer l'accès Claude de #{connection.user.full_name} ?" } do %>
              <%= lucide_icon("unplug", size: 14) %> Révoquer
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @connections.empty? %>
        <tr><td colspan="5" class="px-4 py-3 text-gray-400 italic">Aucune connexion active</td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
