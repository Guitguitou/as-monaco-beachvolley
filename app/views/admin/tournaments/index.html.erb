<%= render PageHeaderComponent.new(title: "Tournois", icon: "trophy", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%= button("Nouveau tournoi", variant: :primary, size: :medium, href: new_admin_tournament_path) %>
  <% end %>
<% end %>

<%= render TableComponent.new(framed: true) do |table| %>
  <% %w[Titre Dates Niveau Paiement].each { |label| table.with_column(label) } %>
  <% @tournaments.each do |tournament| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium) { link_to tournament.title, admin_tournament_path(tournament), class: "hover:text-brand" } %>
      <% row.with_cell { "#{l tournament.starts_on}#{" — #{l tournament.ends_on}" if tournament.ends_on != tournament.starts_on}" } %>
      <% row.with_cell { render BadgeComponent.new(label: tournament.level_label, variant: :neutral, size: :xs) } %>
      <% row.with_cell do %>
        <%= render BadgeComponent.new(label: tournament.payment_open? ? "Ouvert" : "Fermé", variant: tournament.payment_open? ? :success : :neutral, size: :xs) %>
      <% end %>
    <% end %>
  <% end %>
  <% table.with_empty(icon: "trophy", message: "Aucun tournoi pour l'instant.") %>
<% end %>
