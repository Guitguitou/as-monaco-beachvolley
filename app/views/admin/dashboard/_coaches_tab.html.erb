<%= render "season_header" %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <div class="xl:col-span-2">
    <%= render CardComponent.new(title: "Entraînements par mois", subtitle: "Par coach", icon: "chart-column", padding: :lg) do %>
      <% series = @report.trainings_by_coach %>
      <% if series.any? %>
        <%= column_chart series, stacked: true, id: "coaches-chart" %>
        <%= render "chart_table", series: series, unit: nil %>
      <% else %>
        <%= render EmptyStateComponent.new(icon: "dumbbell", title: "Aucun entraînement sur la saison", compact: true) %>
      <% end %>
    <% end %>
  </div>
  <%= render CardComponent.new(title: "Bilan de la saison", icon: "wallet", padding: :none) do %>
    <%= render TableComponent.new do |table| %>
      <% table.with_column("Coach") %>
      <% table.with_column("Entraînements", align: :right) %>
      <% table.with_column("Salaire", align: :right) %>
      <% @report.rows.each do |row| %>
        <% table.with_row do |r| %>
          <% r.with_cell(weight: :medium) { link_to row.coach.full_name, admin_user_path(row.coach), class: "hover:text-brand" } %>
          <% r.with_cell(align: :right) { row.count.to_s } %>
          <% r.with_cell(align: :right, weight: :semibold) { "#{number_with_delimiter(row.amount_eur, delimiter: " ")} €" } %>
        <% end %>
      <% end %>
      <% table.with_empty(icon: "users", message: "Aucun coach actif") %>
    <% end %>
  <% end %>
</div>
