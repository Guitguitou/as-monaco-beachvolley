<section aria-labelledby="week-title" class="mb-8">
  <h2 id="week-title" class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-3">Cette semaine</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
    <% @home.metrics.each do |metric| %>
      <%= render Admin::KpiTileComponent.new(metric: metric) %>
    <% end %>
  </div>
</section>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <%= render CardComponent.new(title: "À traiter", icon: "list-checks", padding: :none) do %>
    <ul class="divide-y divide-gray-100">
      <% @home.actions.each do |action| %>
        <li>
          <%= link_to action.path, class: "flex items-center gap-3 px-5 py-3 hover:bg-gray-50" do %>
            <%= lucide_icon(action.icon, class: "w-4 h-4 text-gray-400 shrink-0") %>
            <span class="flex-1 text-sm text-gray-800"><%= action.label %></span>
            <%= render BadgeComponent.new(label: action.count.to_s, variant: action.count.zero? ? :neutral : :warning, size: :xs) %>
            <%= lucide_icon("chevron-right", class: "w-4 h-4 text-gray-300") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="xl:col-span-2">
    <%= render CardComponent.new(title: "Séances à risque", subtitle: "7 prochains jours, remplies à moins de 40 %",
                                 icon: "triangle-alert", padding: :none) do %>
      <% if @home.at_risk_sessions.any? %>
        <ul class="divide-y divide-gray-100">
          <% @home.at_risk_sessions.each do |risk| %>
            <% session = risk.session %>
            <li>
              <%= link_to admin_session_path(session), class: "grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_10rem_auto] items-center gap-3 px-5 py-3 hover:bg-gray-50" do %>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-gray-900 truncate"><%= session.title.presence || Sessions::SessionType.for(session.session_type).label %></span>
                  <span class="block text-xs text-gray-500">
                    <%= l(session.start_at, format: "%a %d/%m %H:%M") %> · <%= session.terrain&.name %> · <%= session.user&.full_name %>
                  </span>
                </span>
                <span class="hidden sm:block">
                  <%= render ProgressBarComponent.new(value: risk.confirmed, max: session.max_players) %>
                </span>
                <span class="text-sm tabular-nums font-semibold <%= risk.fill_rate < 20 ? 'text-red-700' : 'text-orange-700' %>">
                  <%= risk.confirmed %>/<%= session.max_players %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render EmptyStateComponent.new(icon: "check-circle", title: "Toutes les séances de la semaine sont bien remplies", compact: true) %>
      <% end %>
    <% end %>
  </div>
</div>
