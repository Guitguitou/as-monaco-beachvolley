<%# Les valeurs d'un graphique en tableau, repliées sous le graphique :
    lecture exacte, et accès aux données sans la couleur. %>
<details class="mt-4 text-sm">
  <summary class="cursor-pointer text-gray-600 hover:text-brand">Voir les données en tableau</summary>
  <div class="mt-2 overflow-x-auto">
    <table class="min-w-full text-xs tabular-nums">
      <thead class="bg-gray-50 text-gray-500">
        <tr>
          <th class="px-3 py-2 text-left font-medium"></th>
          <% series.first[:data].each_key do |month| %><th class="px-3 py-2 text-right font-medium"><%= month %></th><% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% series.each do |serie| %>
          <tr>
            <th scope="row" class="px-3 py-2 text-left font-medium text-gray-700"><%= serie[:name] %></th>
            <% serie[:data].each_value do |value| %><td class="px-3 py-2 text-right text-gray-900"><%= number_with_delimiter(value, delimiter: " ") %><%= unit %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</details>
