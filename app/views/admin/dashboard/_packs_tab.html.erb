<!-- Statistiques Mensuelles (Année en cours) -->
<div class="mb-8">
  <%= render CardComponent.new(title: "Statistiques Mensuelles - #{Time.current.year}", subtitle: "Récapitulatif des packs achetés par mois", icon: "calendar-days", padding: :none) do %>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Période
            </th>
            <% @pack_types.each do |pack_type| %>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider" colspan="2">
                <%= case pack_type
                    when 'credits' then 'Crédits'
                    when 'licence' then 'Licence'
                    when 'stage' then 'Stage'
                    when 'inscription_tournoi' then 'Inscription tournoi'
                    when 'equipements' then 'Équipements'
                    when 'autre' then 'Autres (pack supprimé)'
                    else pack_type.humanize
                    end %>
              </th>
            <% end %>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider bg-gray-100">
              Total
            </th>
          </tr>
          <tr class="bg-gray-50 border-t border-gray-200">
            <th class="px-6 py-2 text-left text-xs font-medium text-gray-400">
            </th>
            <% @pack_types.each do |pack_type| %>
              <th class="px-3 py-2 text-center text-xs font-medium text-gray-400">
                Qté
              </th>
              <th class="px-3 py-2 text-center text-xs font-medium text-gray-400">
                Montant
              </th>
            <% end %>
            <th class="px-6 py-2 text-right text-xs font-medium text-gray-400 bg-gray-100">
              €
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @monthly_stats.any? %>
            <% @monthly_stats.each do |stat| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= stat[:period] %>
                </td>
                <% @pack_types.each do |pack_type| %>
                  <% type_data = stat[:by_type][pack_type] %>
                  <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                    <%= type_data ? type_data[:count] : '-' %>
                  </td>
                  <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                    <% if type_data %>
                      <%= number_to_currency(type_data[:amount], unit: "", separator: ",", delimiter: " ") %>€
                    <% else %>
                      -
                    <% end %>
                  </td>
                <% end %>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900 text-right bg-gray-50">
                  <%= number_to_currency(stat[:total], unit: "", separator: ",", delimiter: " ") %>€
                </td>
              </tr>
            <% end %>
            
            <!-- Total Annuel -->
            <tr class="bg-blue-50 font-semibold">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <strong>Total <%= Time.current.year %></strong>
              </td>
              <% @pack_types.each do |pack_type| %>
                <% 
                  total_count = @monthly_stats.sum { |s| s[:by_type][pack_type]&.dig(:count) || 0 }
                  total_amount = @monthly_stats.sum { |s| s[:by_type][pack_type]&.dig(:amount) || 0 }
                %>
                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                  <%= total_count %>
                </td>
                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                  <%= number_to_currency(total_amount, unit: "", separator: ",", delimiter: " ") %>€
                </td>
              <% end %>
              <td class="px-6 py-4 whitespace-nowrap text-base font-bold text-gray-900 text-right bg-gray-100">
                <%= number_to_currency(@monthly_stats.sum { |s| s[:total] }, unit: "", separator: ",", delimiter: " ") %>€
              </td>
            </tr>
          <% else %>
            <tr>
              <td colspan="<%= 1 + (@pack_types.size * 2) + 1 %>" class="px-6 py-8 text-center text-gray-500">
                Aucun achat de pack enregistré pour l'année <%= Time.current.year %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<!-- Statistiques Annuelles -->
<div class="mb-8">
  <%= render CardComponent.new(title: "Statistiques Annuelles", subtitle: "Récapitulatif historique par année", icon: "bar-chart-3", padding: :none) do %>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Année
            </th>
            <% @pack_types.each do |pack_type| %>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider" colspan="2">
                <%= case pack_type
                    when 'credits' then 'Crédits'
                    when 'licence' then 'Licence'
                    when 'stage' then 'Stage'
                    when 'inscription_tournoi' then 'Inscription tournoi'
                    when 'equipements' then 'Équipements'
                    when 'autre' then 'Autres (pack supprimé)'
                    else pack_type.humanize
                    end %>
              </th>
            <% end %>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider bg-gray-100">
              Total
            </th>
          </tr>
          <tr class="bg-gray-50 border-t border-gray-200">
            <th class="px-6 py-2 text-left text-xs font-medium text-gray-400">
            </th>
            <% @pack_types.each do |pack_type| %>
              <th class="px-3 py-2 text-center text-xs font-medium text-gray-400">
                Qté
              </th>
              <th class="px-3 py-2 text-center text-xs font-medium text-gray-400">
                Montant
              </th>
            <% end %>
            <th class="px-6 py-2 text-right text-xs font-medium text-gray-400 bg-gray-100">
              €
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @yearly_stats.any? %>
            <% @yearly_stats.each do |stat| %>
              <tr class="hover:bg-gray-50 <%= 'bg-blue-50' if stat[:year] == Time.current.year %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= stat[:period] %>
                  <% if stat[:year] == Time.current.year %>
                    <span class="ml-2"><%= render BadgeComponent.new(label: "En cours", variant: :info, size: :xs) %></span>
                  <% end %>
                </td>
                <% @pack_types.each do |pack_type| %>
                  <% type_data = stat[:by_type][pack_type] %>
                  <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                    <%= type_data ? type_data[:count] : '-' %>
                  </td>
                  <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                    <% if type_data %>
                      <%= number_to_currency(type_data[:amount], unit: "", separator: ",", delimiter: " ") %>€
                    <% else %>
                      -
                    <% end %>
                  </td>
                <% end %>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900 text-right bg-gray-50">
                  <%= number_to_currency(stat[:total], unit: "", separator: ",", delimiter: " ") %>€
                </td>
              </tr>
            <% end %>
            
            <!-- Total Général -->
            <tr class="bg-indigo-50 font-bold border-t-2 border-indigo-200">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <strong>TOTAL GÉNÉRAL</strong>
              </td>
              <% @pack_types.each do |pack_type| %>
                <% 
                  total_count = @yearly_stats.sum { |s| s[:by_type][pack_type]&.dig(:count) || 0 }
                  total_amount = @yearly_stats.sum { |s| s[:by_type][pack_type]&.dig(:amount) || 0 }
                %>
                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                  <strong><%= total_count %></strong>
                </td>
                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                  <strong><%= number_to_currency(total_amount, unit: "", separator: ",", delimiter: " ") %>€</strong>
                </td>
              <% end %>
              <td class="px-6 py-4 whitespace-nowrap text-lg font-bold text-indigo-700 text-right bg-indigo-100">
                <%= number_to_currency(@yearly_stats.sum { |s| s[:total] }, unit: "", separator: ",", delimiter: " ") %>€
              </td>
            </tr>
          <% else %>
            <tr>
              <td colspan="<%= 1 + (@pack_types.size * 2) + 1 %>" class="px-6 py-8 text-center text-gray-500">
                Aucun achat de pack enregistré
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<!-- KPIs Packs -->
<%
  pack_type_label = ->(type) {
    { "credits" => "Crédits", "licence" => "Licence", "stage" => "Stage", "inscription_tournoi" => "Inscription tournoi",
      "equipements" => "Équipements", "autre" => "Autres (pack supprimé)" }.fetch(type) { type.humanize }
  }
  money = ->(amount) { number_to_currency(amount, unit: "", separator: ",", delimiter: " ") }
  most_popular_type = @pack_types.max_by do |type|
    @yearly_stats.sum { |s| s[:by_type][type]&.dig(:count) || 0 }
  end
  most_popular_count = @yearly_stats.sum { |s| s[:by_type][most_popular_type]&.dig(:count) || 0 }
%>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <%= render StatTileComponent.new(value: "#{money.(@monthly_stats.sum { |s| s[:total] })}€", label: "CA Packs #{Time.current.year}", icon: "euro",
                                   hint: "#{@monthly_stats.sum { |s| s[:by_type].values.sum { |v| v[:count] } }} achats") %>
  <%= render StatTileComponent.new(value: "#{money.(@yearly_stats.sum { |s| s[:total] })}€", label: "CA Total (tous temps)", icon: "package",
                                   hint: "#{@yearly_stats.sum { |s| s[:by_type].values.sum { |v| v[:count] } }} achats") %>
  <%= render StatTileComponent.new(value: most_popular_type ? pack_type_label.(most_popular_type) : "-", label: "Pack le plus populaire", icon: "star",
                                   hint: "#{most_popular_count} achats") %>
</div>
