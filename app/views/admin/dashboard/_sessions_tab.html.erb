<% session_type_tabs = [
  [ "Sessions prévues", "" ],
  [ "Entrainements", "entrainement" ],
  [ "Jeux libres", "jeu_libre" ],
  [ "Coachings privés", "coaching_prive" ]
] %>

<!-- Sous-onglets par type -->
<div class="mb-6">
  <%= render TabsComponent.new(tabs: session_type_tabs.map { |(label, param_value)|
        { label: label,
          href: admin_root_path(tab: "sessions", session_type: param_value),
          active: (param_value.blank? && @sessions_tab.upcoming?) || @sessions_tab.sub_tab == param_value }
      }) %>
</div>

<% if @sessions_tab.upcoming? %>
  <!-- Sessions prévues (à partir d'aujourd'hui) -->
  <%= render CardComponent.new(title: "Sessions prévues", icon: "calendar", padding: :none, class_name: "overflow-hidden mb-8") do %>
    <%= render TableComponent.new do |table| %>
      <% %w[Date Type Titre Responsable Participants Actions].each { |label| table.with_column(label) } %>
      <% @sessions_tab.upcoming_sessions.each do |session| %>
        <% session_type = Sessions::SessionType.for(session.session_type) %>
        <% table.with_row do |row| %>
          <% row.with_cell { l(session.start_at, format: :short) } %>
          <% row.with_cell { render BadgeComponent.new(label: session_type.label, variant: session_type.badge, size: :xs) } %>
          <% row.with_cell(wrap: true) { session.title } %>
          <% row.with_cell { link_to session.user&.full_name, admin_session_path(session), class: "text-brand hover:underline" } %>
          <% row.with_cell { "#{session.registrations.confirmed.count}/#{session.max_players || '∞'}" } %>
          <% row.with_cell { link_to "Voir", admin_session_path(session), class: "text-brand hover:underline" } %>
        <% end %>
      <% end %>
      <% table.with_empty(icon: "calendar-x", message: "Aucune session prévue.") %>
    <% end %>
  <% end %>
<% else %>
  <!-- Vue par type : période + tableau -->
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <div class="flex items-center gap-2">
      <span class="text-sm font-medium text-gray-700">Période :</span>
      <%= link_to "Semaine", admin_root_path(tab: "sessions", session_type: @sessions_tab.sub_tab, period: "week"), class: "px-3 py-1.5 rounded-none text-sm #{@sessions_tab.period.name == 'week' ? 'bg-brand text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Mois", admin_root_path(tab: "sessions", session_type: @sessions_tab.sub_tab, period: "month"), class: "px-3 py-1.5 rounded-none text-sm #{@sessions_tab.period.name == 'month' ? 'bg-brand text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Année", admin_root_path(tab: "sessions", session_type: @sessions_tab.sub_tab, period: "year"), class: "px-3 py-1.5 rounded-none text-sm #{@sessions_tab.period.name == 'year' ? 'bg-brand text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    </div>
    <span class="text-sm text-gray-600"><%= @sessions_tab.period.label %></span>
    <nav class="flex items-center gap-2" aria-label="Navigation par période">
      <%= link_to "Période précédente", admin_root_path(@sessions_tab.previous_period_params), class: "text-sm text-brand hover:underline" %>
      <%= link_to "Période suivante", admin_root_path(@sessions_tab.next_period_params), class: "text-sm text-brand hover:underline" %>
    </nav>
  </div>

  <%= render CardComponent.new(title: session_type_tabs.to_h.key(@sessions_tab.sub_tab) || @sessions_tab.sub_tab.humanize, icon: "calendar",
                               padding: :none, class_name: "overflow-hidden mb-8") do %>
    <%= render TableComponent.new do |table| %>
      <% [ "Jour", "Nombre de participants", "Responsable" ].each { |label| table.with_column(label) } %>
      <% @sessions_tab.sessions_by_type.each do |session| %>
        <% table.with_row do |row| %>
          <% row.with_cell { l(session.start_at, format: :short) } %>
          <% row.with_cell { session.registrations.confirmed.count.to_s } %>
          <% row.with_cell { link_to session.user&.full_name, admin_session_path(session), class: "text-brand hover:underline" } %>
        <% end %>
      <% end %>
      <% table.with_empty(icon: "calendar-x", message: "Aucune session sur cette période.") %>
    <% end %>
  <% end %>
<% end %>
