<% url = color.persisted? ? admin_shop_product_shop_color_path(product, color) : admin_shop_product_shop_colors_path(product) %>
<% dom = color.persisted? ? "color_#{color.id}" : "color_new" %>
<div class="flex gap-4 <%= 'border border-gray-200 p-4' if color.persisted? %>">
  <% if color.persisted? %>
    <%= render "admin/shop_products/photo", color: color, size: "w-24 h-24" %>
  <% end %>
  <div class="flex-1 space-y-3">
    <%= form_with model: color, url: url, scope: :shop_color, namespace: dom, class: "space-y-3" do |f| %>
      <div class="grid grid-cols-3 gap-3 items-end">
        <div class="col-span-2">
          <%= render FormFieldComponent.new(form: f, attribute: :name, label: "Nom", required: true, html_options: { id: "#{dom}_name", placeholder: "Rouge" }) %>
        </div>
        <div>
          <%= f.label :hex, "Couleur", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.color_field :hex, class: "w-full h-10 border border-gray-300 rounded-none" %>
        </div>
      </div>
      <div>
        <%= f.label :photo, (color.photo.attached? ? "Remplacer la photo" : "Photo"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.file_field :photo, accept: "image/*", class: "block w-full text-sm text-gray-900" %>
      </div>
      <div class="flex items-center gap-2">
        <%= render ButtonComponent.new(type: :submit, variant: (color.persisted? ? :secondary : :primary), size: :small) do %>
          <%= lucide_icon(color.persisted? ? "save" : "plus", size: 16) %> <%= color.persisted? ? "Enregistrer" : "Ajouter le coloris" %>
        <% end %>
      </div>
    <% end %>
    <% if color.persisted? %>
      <%= button_to "Supprimer", admin_shop_product_shop_color_path(product, color), method: :delete,
            data: { turbo_confirm: "Supprimer le coloris #{color.name} ?" },
            class: "text-sm text-gray-600 hover:text-red-600 underline" %>
    <% end %>
  </div>
</div>
