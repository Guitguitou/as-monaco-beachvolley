<%= render PageHeaderComponent.new(title: "Stages", icon: "flag", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <% if can?(:create, Stage) %>
      <%= button("Nouveau stage", variant: :primary, size: :medium, href: new_admin_stage_path) %>
    <% end %>
  <% end %>
<% end %>

<%= render DataTableComponent.new(definition: @table, state: @state, pagination: @page, url: admin_stages_path,
                                  empty_message: "Aucun stage.") do |table| %>
  <% @page.records.each do |stage| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium) do %>
        <%= link_to stage.title.presence || "(Sans titre)", admin_stage_path(stage), class: "hover:text-brand", data: { turbo_frame: "_top" } %>
      <% end %>
      <% row.with_cell { "#{l stage.starts_on, format: :default} — #{l stage.ends_on, format: :default}" } %>
      <% row.with_cell(wrap: true) { [ stage.main_coach&.full_name, stage.assistant_coach&.full_name ].compact.join(" / ") } %>
      <% row.with_cell(align: :right) do %>
        <%= link_to edit_admin_stage_path(stage), class: "inline-flex text-gray-600 hover:text-brand", data: { turbo_frame: "_top" } do %>
          <%= lucide_icon("edit", size: 16) %><span class="sr-only">Modifier</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
