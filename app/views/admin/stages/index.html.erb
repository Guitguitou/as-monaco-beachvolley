<%= render PageHeaderComponent.new(title: "Stages", icon: "flag", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <% if can?(:create, Stage) %>
      <%= button("Nouveau stage", variant: :primary, size: :medium, href: new_admin_stage_path) %>
    <% end %>
  <% end %>
<% end %>

<%= render TableComponent.new(framed: true, fixed: true) do |table| %>
  <% table.with_column("Titre", class_name: "w-1/3") %>
  <% table.with_column("Dates", class_name: "w-1/4") %>
  <% table.with_column("Coachs", class_name: "w-1/4") %>
  <% table.with_column("Actions", align: :right, class_name: "w-16 sm:w-24") %>
  <% @stages.each do |stage| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium) do %>
        <span class="flex items-center gap-2">
          <%= lucide_icon("flag", size: 16, class: "text-gray-500") %>
          <%= stage.title.presence || "(Sans titre)" %>
        </span>
      <% end %>
      <% row.with_cell(wrap: true) { "#{l stage.starts_on, format: :default} — #{l stage.ends_on, format: :default}" } %>
      <% row.with_cell(wrap: true) { [ stage.main_coach&.full_name, stage.assistant_coach&.full_name ].compact.join(" / ") } %>
      <% row.with_cell(align: :right, class_name: "space-x-2") do %>
        <%= link_to admin_stage_path(stage), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand transition-colors" do %>
          <%= lucide_icon("eye", size: 16) %>
        <% end %>
        <%= link_to edit_admin_stage_path(stage), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand-dark transition-colors" do %>
          <%= lucide_icon("edit", size: 16) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% table.with_empty(icon: "flag", message: "Aucun stage.") %>
<% end %>
