<%= render PageHeaderComponent.new(title: "Joueurs", icon: "users", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%= button("Nouveau joueur", variant: :primary, size: :medium, href: new_admin_user_path) %>
  <% end %>
<% end %>

<%= render DataTableComponent.new(definition: @table, state: @state, pagination: @page, url: admin_users_path,
                                  export_url: admin_users_path(format: :csv), empty_message: "Aucun joueur.") do |table| %>
  <% @page.records.each do |user| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium) do %>
        <%= link_to "#{user.last_name} #{user.first_name}", admin_user_path(user), class: "hover:text-brand", data: { turbo_frame: "_top" } %>
      <% end %>
      <% row.with_cell { user.email } %>
      <% row.with_cell(class_name: "space-x-1") do %>
        <% @table.roles(user).each do |role| %>
          <%= render BadgeComponent.new(label: role, variant: :neutral, size: :xs) %>
        <% end %>
      <% end %>
      <% row.with_cell { render BadgeComponent.new(label: @table.license_label(user), variant: :neutral, size: :xs) } %>
      <% row.with_cell { render BadgeComponent.new(label: user.activated? ? "Oui" : "Non", variant: user.activated? ? :success : :danger, size: :xs) } %>
      <% row.with_cell { render BadgeComponent.new(label: user.dossier_complet? ? "Oui" : "Non", variant: user.dossier_complet? ? :success : :warning, size: :xs) } %>
      <% row.with_cell(wrap: true) { user.levels.map(&:display_name).join(", ").presence || "–" } %>
      <% row.with_cell(align: :right) do %>
        <%= link_to edit_admin_user_path(user), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand", data: { turbo_frame: "_top" } do %>
          <%= lucide_icon("edit", size: 16) %><span class="sr-only">Modifier</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
