<%= render PageHeaderComponent.new(title: "Gestion des Packs", icon: "package", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%= button("Nouveau pack", variant: :primary, size: :medium, href: new_admin_pack_path) %>
  <% end %>
<% end %>

<% type_badges = { "credits" => [ "Crédits", :neutral ], "licence" => [ "Licence", :neutral ], "stage" => [ "Stage", :warning ],
                    "inscription_tournoi" => [ "Inscription tournoi", :danger ], "equipements" => [ "Équipements", :neutral ] } %>
<%= render TableComponent.new(framed: true, fixed: true) do |table| %>
  <% table.with_column("Nom") %>
  <% table.with_column("Type", class_name: "hidden sm:table-cell") %>
  <% table.with_column("Montant") %>
  <% table.with_column("Crédits", class_name: "hidden md:table-cell") %>
  <% table.with_column("Stage", class_name: "hidden lg:table-cell") %>
  <% table.with_column("Position", class_name: "hidden xl:table-cell") %>
  <% table.with_column("Hors connexion", class_name: "hidden lg:table-cell") %>
  <% table.with_column("Statut") %>
  <% table.with_column("Actions", align: :right, class_name: "w-16 sm:w-24") %>
  <% @packs.each do |pack| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium, wrap: true) { pack.name } %>
      <% row.with_cell(class_name: "hidden sm:table-cell") do %>
        <% label, variant = type_badges.fetch(pack.pack_type) { [ pack.pack_type.humanize, :neutral ] } %>
        <%= render BadgeComponent.new(label: label, variant: variant, size: :xs) %>
      <% end %>
      <% row.with_cell(weight: :semibold) { number_to_currency(pack.amount_eur, unit: "€", precision: 2) } %>
      <% row.with_cell(class_name: "hidden md:table-cell") { pack.credits.present? ? pack.credits.to_s : tag.span("–", class: "text-gray-400") } %>
      <% row.with_cell(wrap: true, class_name: "hidden lg:table-cell") { pack.stage.present? ? pack.stage.title : tag.span("–", class: "text-gray-400") } %>
      <% row.with_cell(class_name: "hidden xl:table-cell") { pack.position.to_s } %>
      <% row.with_cell(class_name: "hidden lg:table-cell") do %>
        <% if pack.public? %>
          <%= render BadgeComponent.new(label: "Oui", variant: :warning, size: :xs) %>
        <% else %>
          <span class="text-gray-400">Non</span>
        <% end %>
      <% end %>
      <% row.with_cell { render BadgeComponent.new(label: pack.active? ? "Actif" : "Inactif", variant: pack.active? ? :success : :neutral, size: :xs) } %>
      <% row.with_cell(align: :right, class_name: "space-x-2") do %>
        <%= link_to edit_admin_pack_path(pack), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand transition-colors" do %>
          <%= lucide_icon("edit", size: 16) %>
          <span class="hidden sm:inline">Modifier</span>
        <% end %>
        <%= button_to admin_pack_path(pack), method: :delete,
              data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer ce pack ?" },
              class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-red-600 transition-colors" do %>
          <%= lucide_icon("trash-2", size: 16) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @packs.empty? %>
  <div class="mt-6">
    <%= render EmptyStateComponent.new(icon: "package", title: "Aucun pack pour le moment") do |empty| %>
      <% empty.with_action { button("Créer le premier pack", variant: :primary, size: :medium, href: new_admin_pack_path) } %>
    <% end %>
  </div>
<% end %>
