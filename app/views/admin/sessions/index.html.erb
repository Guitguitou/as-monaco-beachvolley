<%= render PageHeaderComponent.new(title: "Séances", icon: "calendar-clock", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <% if can?(:create, Session) %>
      <%= button("Nouvelle séance", variant: :primary, size: :medium, href: new_admin_session_path) %>
    <% end %>
  <% end %>
<% end %>

<%= render DataTableComponent.new(definition: @table, state: @state, pagination: @page, url: admin_sessions_path,
                                  empty_message: "Aucune séance.") do |table| %>
  <% @page.records.each do |session| %>
    <% session_type = Sessions::SessionType.for(session.session_type) %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium, wrap: true) do %>
        <%= link_to session.title.presence || "(Sans titre)", admin_session_path(session), class: "hover:text-brand", data: { turbo_frame: "_top" } %>
      <% end %>
      <% row.with_cell { render BadgeComponent.new(label: session_type.label, variant: session_type.badge, size: :xs) } %>
      <% row.with_cell { "#{l session.start_at, format: "%d/%m/%Y %H:%M"}–#{l session.end_at, format: "%H:%M"}" } %>
      <% row.with_cell { session.terrain&.name } %>
      <% row.with_cell(wrap: true) { @table.levels_label(session) } %>
      <% row.with_cell { session.user&.full_name || "–" } %>
      <% row.with_cell { [ @confirmed_counts[session.id].to_i, session.max_players ].compact.join(" / ") } %>
      <% row.with_cell do %>
        <%= render BadgeComponent.new(label: session.cancelled? ? "Annulée" : "Prévue", variant: session.cancelled? ? :danger : :neutral, size: :xs) %>
      <% end %>
      <% row.with_cell(align: :right, class_name: "space-x-2") do %>
        <%= link_to edit_admin_session_path(session), class: "inline-flex text-gray-600 hover:text-brand", data: { turbo_frame: "_top" } do %>
          <%= lucide_icon("edit", size: 16) %><span class="sr-only">Modifier</span>
        <% end %>
        <%= link_to admin_session_path(session),
              data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette séance ?" },
              class: "inline-flex text-gray-600 hover:text-red-600" do %>
          <%= lucide_icon("trash", size: 16) %><span class="sr-only">Supprimer</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
