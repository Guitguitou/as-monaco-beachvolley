<%= render PageHeaderComponent.new(title: "Groupes de niveau", icon: "layers", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%= button("Nouveau groupe", variant: :primary, size: :medium, href: new_admin_level_path) %>
  <% end %>
<% end %>

<%= render TableComponent.new(framed: true, fixed: true) do |table| %>
  <% table.with_column("Nom") %>
  <% table.with_column("Genre", class_name: "hidden sm:table-cell") %>
  <% table.with_column("Couleur", class_name: "hidden md:table-cell") %>
  <% table.with_column("Actions", align: :right, class_name: "w-16 sm:w-24") %>
  <% @levels.each do |level| %>
    <% table.with_row do |row| %>
      <% row.with_cell(weight: :medium) { level.name } %>
      <% row.with_cell(class_name: "capitalize hidden sm:table-cell") { level.gender } %>
      <% row.with_cell(class_name: "hidden md:table-cell") do %>
        <div class="h-6 w-6 rounded-none border border-gray-300 shadow-sm" style="background-color: <%= level.color %>"></div>
      <% end %>
      <% row.with_cell(align: :right, class_name: "space-x-2") do %>
        <%= link_to admin_level_path(level), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand transition-colors" do %>
          <%= lucide_icon("eye", size: 16) %> Voir
        <% end %>
        <%= link_to edit_admin_level_path(level), class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-brand-dark transition-colors" do %>
          <%= lucide_icon("edit", size: 16) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% table.with_empty(icon: "layers", message: "Aucun groupe de niveau.") %>
<% end %>
