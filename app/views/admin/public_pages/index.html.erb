<div class="flex items-center justify-between mb-6 flex-col gap-3 sm:flex-row sm:gap-0">
  <h1 class="text-2xl font-bold flex items-center gap-2 text-gray-900">
    <%= lucide_icon("globe") %> Pages publiques
  </h1>

  <%= button("Nouvelle page", variant: :primary, size: :medium, href: new_admin_public_page_path) %>
</div>

<p class="text-sm text-gray-600 mb-4">
  Chaque page affiche une web app Google Apps Script à l'adresse publique indiquée, accessible sans compte.
</p>

<div class="overflow-x-auto rounded-none border border-gray-200 shadow-sm">
  <table class="min-w-full divide-y divide-gray-200 bg-white text-sm">
    <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wide">
      <tr>
        <th class="px-4 sm:px-6 py-3 text-left">Page</th>
        <th class="px-4 sm:px-6 py-3 text-left">Adresse publique</th>
        <th class="px-4 sm:px-6 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @public_pages.each do |public_page| %>
        <tr>
          <td class="px-4 sm:px-6 py-3 font-medium text-gray-900"><%= public_page.title %></td>
          <td class="px-4 sm:px-6 py-3">
            <%= link_to public_page_url(public_page.slug), public_page_path(public_page.slug), target: "_blank", rel: "noopener", class: "text-brand hover:underline break-all" %>
          </td>
          <td class="px-4 sm:px-6 py-3 text-right whitespace-nowrap space-x-2">
            <%= link_to lucide_icon("pencil", size: 16), edit_admin_public_page_path(public_page), class: "inline-flex text-gray-600 hover:text-brand", title: "Modifier" %>
            <%= button_to lucide_icon("trash-2", size: 16), admin_public_page_path(public_page), method: :delete, form_class: "inline", class: "inline-flex text-gray-600 hover:text-red-600", title: "Supprimer", data: { turbo_confirm: "Supprimer cette page publique ?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @public_pages.empty? %>
  <p class="text-center text-gray-500 py-8">Aucune page publique.</p>
<% end %>
