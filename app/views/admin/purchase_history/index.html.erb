<%= render PageHeaderComponent.new(title: "Historique des achats", icon: "shopping-cart", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%# Formulaire d'export %>
    <%= render CardComponent.new(padding: :md, class_name: "w-full sm:w-auto") do %>
      <%= form_with url: export_admin_purchase_history_index_path, method: :get, local: true, data: { turbo: false }, class: "flex flex-col sm:flex-row gap-3 items-end" do |f| %>
        <div class="flex flex-col sm:flex-row gap-3 flex-1">
          <div class="flex flex-col">
            <%= render FormFieldComponent.new(
              form: f,
              attribute: :start_date,
              type: :date_field,
              label: "Date de début",
              required: true,
              input_class: "px-3 py-2 border border-gray-300 rounded-none text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent",
              html_options: { value: params[:start_date] || Date.current.beginning_of_month }
            ) %>
          </div>
          <div class="flex flex-col">
            <%= render FormFieldComponent.new(
              form: f,
              attribute: :end_date,
              type: :date_field,
              label: "Date de fin",
              required: true,
              input_class: "px-3 py-2 border border-gray-300 rounded-none text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent",
              html_options: { value: params[:end_date] || Date.current.end_of_month }
            ) %>
          </div>
          <fieldset class="flex flex-col gap-2 min-w-[10rem]">
            <legend class="text-sm font-medium text-gray-700">Format d'export</legend>
            <div class="flex flex-col sm:flex-row gap-2 sm:gap-4">
              <label class="inline-flex items-center gap-2 text-sm text-gray-800 cursor-pointer">
                <%= f.radio_button :export_format, "csv", checked: params[:export_format].to_s != "xlsx", class: "text-brand focus:ring-brand" %>
                CSV
              </label>
              <label class="inline-flex items-center gap-2 text-sm text-gray-800 cursor-pointer">
                <%= f.radio_button :export_format, "xlsx", class: "text-brand focus:ring-brand" %>
                Excel (.xlsx)
              </label>
            </div>
          </fieldset>
        </div>
        <%= render ButtonComponent.new(type: "submit", class: "whitespace-nowrap") do %>
          <%= lucide_icon("download", size: 16) %> Exporter
        <% end %>
      <% end %>
      <p class="text-xs text-gray-500 mt-2">Par défaut, le mois en cours est sélectionné</p>
    <% end %>
  <% end %>
<% end %>

<%# Stats Cards %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <%= render StatTileComponent.new(value: number_to_currency(@total_revenue, unit: "€", precision: 2), label: "Chiffre d'affaires", icon: "euro") %>
  <%= render StatTileComponent.new(value: @total_purchases, label: "Total achats", icon: "shopping-bag") %>
  <%= render StatTileComponent.new(value: @pending_purchases, label: "En attente", icon: "clock") %>
</div>

<%= render DataTableComponent.new(definition: @table, state: @state, pagination: @page,
                                  url: admin_purchase_history_index_path, empty_message: "Aucun achat.") do |table| %>
  <% status_variants = { "paid" => :success, "pending" => :warning, "failed" => :danger, "cancelled" => :neutral } %>
  <% @page.records.each do |purchase| %>
    <% table.with_row do |row| %>
      <% row.with_cell { l(purchase.created_at, format: "%d/%m/%Y %H:%M") } %>
      <% row.with_cell(wrap: true) do %>
        <div class="flex flex-col">
          <span class="font-medium text-gray-800"><%= purchase.user.full_name %></span>
          <span class="text-xs text-gray-500"><%= purchase.user.email %></span>
        </div>
      <% end %>
      <% row.with_cell(wrap: true) { purchase.pack || purchase.shop_order ? purchase.label : tag.span(purchase.label, class: "text-gray-400 italic") } %>
      <% row.with_cell(weight: :semibold) { number_to_currency(purchase.amount_eur, unit: "€", precision: 2) } %>
      <% row.with_cell { purchase.credits.to_s } %>
      <% row.with_cell do %>
        <%= render BadgeComponent.new(label: Admin::Tables::Purchases::STATUS_LABELS.fetch(purchase.status, purchase.status),
                                      variant: status_variants.fetch(purchase.status, :neutral), size: :xs) %>
      <% end %>
      <% row.with_cell(class_name: "text-xs font-mono text-gray-500") { purchase.sherlock_transaction_reference } %>
    <% end %>
  <% end %>
<% end %>
