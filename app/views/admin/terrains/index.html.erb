<%= render PageHeaderComponent.new(title: "Terrains", icon: "map-pin", variant: :admin) do |header| %>
  <% header.with_actions do %>
    <%= button("Nouveau terrain", variant: :primary, size: :medium, href: new_admin_terrain_path) %>
  <% end %>
<% end %>

<p class="text-sm text-gray-600 mb-4">
  L'ordre et la couleur s'appliquent au calendrier, aux filtres et aux cartes de session. Un terrain archivé n'est plus proposé mais reste affiché sur les anciennes sessions.
</p>

<% { "Terrains actifs" => @active_terrains, "Terrains archivés" => @archived_terrains }.each do |title, terrains| %>
  <% next if terrains.empty? && title == "Terrains archivés" %>
  <h2 class="font-bebas-neue text-lg tracking-widest text-gray-500 mt-6 mb-2"><%= title %></h2>
  <%= render TableComponent.new(framed: true) do |table| %>
    <% table.with_column("Terrain") %>
    <% table.with_column("Couleur", class_name: "hidden sm:table-cell") %>
    <% table.with_column("Actions", align: :right) %>
    <% table.with_empty(icon: "map-pin", message: "Aucun terrain actif.") %>
    <% terrains.each_with_index do |terrain, index| %>
      <%= render "row", terrain: terrain, first: index.zero?, last: index == terrains.size - 1 %>
    <% end %>
  <% end %>
<% end %>
