<% money = ->(amount) { number_to_currency(amount, unit: "", separator: ",", delimiter: "") } %>
<% month_profit = @revenues[:month] - @coach_salaries[:month] %>

<!-- KPIs Financiers -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
  <%= render StatTileComponent.new(value: "#{money.(@revenues[:week])}€", label: "CA Semaine", icon: "euro", hint: "Achats de crédits") %>
  <%= render StatTileComponent.new(value: "#{money.(@revenues[:month])}€", label: "CA Mois", icon: "calendar-days", hint: "Achats de crédits") %>
  <%= render StatTileComponent.new(value: "#{money.(@coach_salaries[:month])}€", label: "Salaires Coachs (Mois)", icon: "users", hint: "Charges") %>
  <%= render StatTileComponent.new(value: "#{money.(month_profit)}€", label: "Bénéfice (Mois)", icon: "trending-up", hint: "CA - Salaires",
                                   tone: month_profit >= 0 ? :positive : :negative) %>
</div>

<!-- Évolution mensuelle du CA par type de pack -->
<div class="mb-8">
  <%= render Admin::MonthlyRevenueChartComponent.new(months: @monthly_revenue, pack_types: CreditPurchase::REPORTING_PACK_TYPES) %>
</div>

<!-- Tableaux de Différences CA - Salaires -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <% { week: "Semaine", month: "Mois", year: "Année" }.each do |period, name| %>
    <% difference = @revenues[period] - @coach_salaries[period] %>
    <%= render CardComponent.new(title: "Différence #{name}", icon: "trending-up", padding: :lg) do %>
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-gray-500">CA <%= name %></span>
          <span class="text-sm font-semibold text-gray-900"><%= money.(@revenues[period]) %>€</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-gray-500">Salaires Coachs</span>
          <span class="text-sm font-semibold text-gray-900"><%= money.(@coach_salaries[period]) %>€</span>
        </div>
        <hr class="border-gray-200">
        <div class="flex justify-between items-center">
          <span class="text-sm font-bold text-gray-900">Différence</span>
          <span class="text-lg font-bold <%= difference >= 0 ? 'text-green-600' : 'text-red-600' %>"><%= money.(difference) %>€</span>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<!-- Détail des Revenus par Type -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Revenus par Type de Session (Information visuelle) -->
  <%= render CardComponent.new(title: "Revenus par Type de Session (Mois)", icon: "volleyball", padding: :lg) do |card| %>
    <% card.with_title_aside { render BadgeComponent.new(label: "Info", variant: :info, size: :xs) } %>
    <div>
      <% if @breakdowns[:sessions].any? %>
        <div class="space-y-3">
          <% @breakdowns[:sessions].each do |session_type, amount| %>
            <div class="flex justify-between items-center p-3 bg-gray-50 rounded-none">
              <span class="text-sm font-medium text-gray-700">
                <%= case session_type
                    when 'entrainement' then 'Entraînements'
                    when 'jeu_libre' then 'Jeux libres'
                    when 'coaching_prive' then 'Coachings privés'
                    else session_type.humanize
                    end %>
              </span>
              <span class="text-sm font-semibold text-gray-900">
                <%= number_to_currency(amount, unit: "", separator: ",", delimiter: "") %>€
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render EmptyStateComponent.new(icon: "volleyball", title: "Aucun revenu de session ce mois", compact: true) %>
      <% end %>
    </div>
  <% end %>

  <!-- CA par Type d'Achat -->
  <%= render CardComponent.new(title: "CA par Type d'Achat (Mois)", icon: "package", padding: :lg) do %>
    <div>
      <% if @breakdowns[:packs].any? %>
        <div class="space-y-3">
          <% @breakdowns[:packs].each do |pack_type, amount| %>
            <div class="flex justify-between items-center p-3 bg-gray-50 rounded-none">
              <span class="text-sm font-medium text-gray-700">
                <%= case pack_type
                    when 'credits' then 'Packs de Crédits'
                    when 'stage' then 'Packs de Stage'
                    when 'licence' then 'Packs de Licence'
                    when 'inscription_tournoi' then 'Inscriptions tournoi'
                    when 'equipements' then 'Équipements'
                    when 'autre' then 'Autres (pack supprimé)'
                    else pack_type.humanize
                    end %>
              </span>
              <span class="text-sm font-semibold text-gray-900">
                <%= number_to_currency(amount, unit: "", separator: ",", delimiter: "") %>€
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render EmptyStateComponent.new(icon: "package", title: "Aucun CA ce mois", compact: true) %>
      <% end %>
    </div>
  <% end %>
</div>
