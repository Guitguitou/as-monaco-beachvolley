<%= link_to annonce_path(annonce), class: "block border border-gray-200 hover:border-asmbv-red transition-colors p-4 bg-white rounded-xl" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-semibold text-gray-900 truncate"><%= annonce.title %></h3>
      <p class="text-xs text-gray-500 mt-0.5">par <%= annonce.user.full_name %></p>
    </div>
    <%= render BadgeComponent.new(label: annonce_status_label(annonce), variant: annonce_status_variant(annonce), size: :xs) %>
  </div>

  <% if annonce.levels.any? %>
    <div class="flex flex-wrap gap-1 mt-2">
      <% annonce.levels.each do |level| %>
        <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-700 rounded-full"><%= level.display_name %></span>
      <% end %>
    </div>
  <% end %>

  <ul class="mt-3 space-y-1">
    <% annonce.slots.sort_by(&:start_at).first(3).each do |slot| %>
      <li class="flex items-center gap-2 text-sm <%= slot.upcoming? ? 'text-gray-700' : 'text-gray-400 line-through' %>">
        <%= lucide_icon("calendar", class: "size-4 text-gray-400") %>
        <span><%= annonce_slot_range(slot) %></span>
        <span class="text-xs text-gray-400">· <%= slot.availabilities.size %>/<%= annonce.min_players %></span>
      </li>
    <% end %>
  </ul>
<% end %>
