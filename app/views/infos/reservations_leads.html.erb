<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">Responsables de réservations</h1>
    <%= render BackLinkComponent.new(href: infos_root_path) %>
  </div>

  <%= render CardComponent.new(padding: :sm) do %>
    <p class="text-sm text-gray-600 mb-4">Liste des responsables par créneau (Google Sheets).</p>
    <div class="w-full h-[70vh]">
      <iframe class="w-full h-full rounded-none" src="https://docs.google.com/spreadsheets/d/1BpHXmKKgNQNe6Dir58-76Gd95snAYi9EaZpCfpj-te4/preview"></iframe>
    </div>
    <div class="mt-3">
      <a href="https://docs.google.com/spreadsheets/d/1BpHXmKKgNQNe6Dir58-76Gd95snAYi9EaZpCfpj-te4/edit?usp=sharing" target="_blank" rel="noopener" class="text-sm text-brand hover:underline">Ouvrir dans Google Sheets</a>
    </div>
  <% end %>
</div>
