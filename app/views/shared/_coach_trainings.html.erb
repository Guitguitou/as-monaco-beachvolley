<%# Bilan des entraînements d'un coach.
    Vue partagée entre l'espace coach et la fiche admin du coach, qui en
    portaient deux copies quasi identiques de 242 lignes.

    locals :
      report:      Coach::TrainingsReport
      admin_links: lie les titres de séance vers l'administration
%>
<div class="space-y-6">
  <!-- Revenue Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Weekly Revenue -->
    <%= render CardComponent.new(padding: :lg) do %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-100 rounded-none flex items-center justify-center">
            <%= lucide_icon("calendar", class: "w-5 h-5 text-blue-600") %>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500">Cette semaine</p>
          <p class="text-2xl font-bold text-gray-900"><%= number_with_precision(report.week_amount, precision: 2) %> €</p>
          <p class="text-xs text-gray-500"><%= pluralize(report.week_count, 'entraînement') %></p>
        </div>
      </div>
    <% end %>

    <!-- Monthly Revenue -->
    <%= render CardComponent.new(padding: :lg) do %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-green-100 rounded-none flex items-center justify-center">
            <%= lucide_icon("calendar-days", class: "w-5 h-5 text-green-600") %>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500">Ce mois</p>
          <p class="text-2xl font-bold text-gray-900"><%= number_with_precision(report.month_amount, precision: 2) %> €</p>
          <p class="text-xs text-gray-500"><%= pluralize(report.month_count, 'entraînement') %></p>
        </div>
      </div>
    <% end %>

    <!-- Yearly Revenue -->
    <%= render CardComponent.new(padding: :lg) do %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-purple-100 rounded-none flex items-center justify-center">
            <%= lucide_icon("calendar-range", class: "w-5 h-5 text-purple-600") %>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500">Cette année</p>
          <p class="text-2xl font-bold text-gray-900"><%= number_with_precision(report.year_amount, precision: 2) %> €</p>
          <p class="text-xs text-gray-500"><%= pluralize(report.year_count, 'entraînement') %></p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Monthly Salary Table -->
  <%= render CardComponent.new(padding: :none) do %>
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
        <%= lucide_icon("euro", class: "w-5 h-5 text-green-500") %>
        Salaire par mois
      </h3>
    </div>
    <%= render TableComponent.new do |table| %>
      <% table.with_column("Mois") %>
      <% table.with_column("Entraînements") %>
      <% table.with_column("Salaire par entraînement") %>
      <% table.with_column("Total") %>
      <% report.monthly_history.each do |month_data| %>
        <% table.with_row do |row| %>
          <% row.with_cell(weight: :medium) { month_data[:month_name] } %>
          <% row.with_cell { month_data[:training_count].to_s } %>
          <% row.with_cell { "#{number_with_precision(report.salary_per_training, precision: 2)} €" } %>
          <% row.with_cell(weight: :semibold) { "#{number_with_precision(month_data[:total_salary], precision: 2)} €" } %>
        <% end %>
      <% end %>
      <% table.with_empty(icon: "calendar-x", message: "Aucun entraînement sur les 12 derniers mois") %>
    <% end %>
  <% end %>

  <!-- Training Tables -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render CardComponent.new(padding: :none) do %>
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <%= lucide_icon("history", class: "w-5 h-5 text-gray-500") %>
          Entraînements passés
        </h3>
      </div>
      <%= render "shared/coach_trainings_table", trainings: report.past_trainings, admin_links: admin_links,
                 empty_icon: "calendar-x", empty_message: "Aucun entraînement passé" %>
    <% end %>
    <%= render CardComponent.new(padding: :none) do %>
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <%= lucide_icon("calendar-clock", class: "w-5 h-5 text-green-500") %>
          Entraînements à venir
        </h3>
      </div>
      <%= render "shared/coach_trainings_table", trainings: report.upcoming_trainings, admin_links: admin_links,
                 empty_icon: "calendar-plus", empty_message: "Aucun entraînement à venir" %>
    <% end %>
  </div>
</div>
