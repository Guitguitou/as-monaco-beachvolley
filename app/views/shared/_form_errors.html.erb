<%# Affiche le bloc d'erreurs de validation (DRY). Utilise I18n errors.messages.not_saved (Devise). %>
<% if object.present? && object.errors.any? %>
  <%= render AlertComponent.new(tone: :error, class: "mb-6", data: { turbo_cache: "false" },
                                title: t("errors.messages.not_saved", count: object.errors.count, resource: object.class.model_name.human.downcase)) do %>
    <ul class="list-disc list-inside space-y-1">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
