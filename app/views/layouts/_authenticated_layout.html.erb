<!-- Layout pour utilisateurs connectés -->
<div class="min-h-screen"
     <% if user_signed_in? && vapid_public_key.present? %>
     data-controller="push-notifications"
     data-push-notifications-vapid-public-key-value="<%= vapid_public_key %>"
     <% end %>>
  <%= render "layouts/navbar" %>

  <% unless controller_path.start_with?("admin/") %>
    <% if content_for?(:hero) %>
      <%= yield :hero %>
    <% elsif default_page_title.present? %>
      <%= render PageHeaderComponent.new(title: default_page_title) %>
    <% end %>
  <% end %>

  <%# pb-24 sur mobile : laisse la place à la barre de navigation basse %>
  <main class="p-4 sm:p-6 lg:p-8 pb-24 lg:pb-8">
    <%= yield %>
  </main>

  <%# Masquée sur les pages qui ont déjà leur propre barre d'action collée en bas
      (fiche session), pour ne pas empiler deux barres. %>
  <% unless content_for?(:sticky_action_bar) %>
    <%= render BottomNavComponent.new(user: current_user, current_path: request.path) %>
  <% end %>
</div>
