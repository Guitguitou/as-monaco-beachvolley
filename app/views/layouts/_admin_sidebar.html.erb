<aside
  class="fixed z-50 inset-y-0 left-0 w-56 bg-white border-r border-gray-200 transform -translate-x-full transition-transform duration-200 ease-in-out lg:translate-x-0 lg:static lg:z-auto lg:block"
  data-admin-sidebar-target="sidebar"
>
  <div class="p-6 flex flex-col h-full space-y-6">
    <div class="flex items-center gap-2 text-brand text-xl font-bold flex-col">
      <%= image_tag "logo.png", class: "w-16 h-16 md:w-20 md:h-20" %>
      <span>Admin</span>
    </div>

    <nav class="flex-1 space-y-2 text-sm">
      <%= nav_link "Dashboard", admin_root_path, icon: "layout-dashboard" %>
      <% if current_user.admin? %>
        <%= nav_link "Joueurs", admin_users_path, icon: "users" %>
        <%= nav_link "Sessions", admin_sessions_path, icon: "calendar" %>
        <%= nav_link "Stages", admin_stages_path, icon: "flag" %>
        <%= nav_link "Tournois", admin_tournaments_path, icon: "trophy" %>
        <%= nav_link "Niveaux", admin_levels_path, icon: "layers" %>
        <%= nav_link "Groupes", admin_groups_path, icon: "users-round" %>
        <%= nav_link "Terrains", admin_terrains_path, icon: "map-pin" %>
        <%= nav_link "Indisponibilité terrains", admin_terrain_closures_path, icon: "ban" %>
        <%= nav_link "Boutique", admin_packs_path, icon: "package" %>
        <%= nav_link "Pages publiques", admin_public_pages_path, icon: "globe" %>
        <%= nav_link "Règles du club", admin_club_rules_path, icon: "sliders-horizontal" %>
        <%= nav_link "Connexions Claude", admin_claude_connections_path, icon: "bot" %>
      <% end %>
      <%= nav_link "Finances", admin_finances_path, icon: "euro" %>
      <%= nav_link "Historique achats", admin_purchase_history_index_path, icon: "shopping-cart" %>
      <%= nav_link "Retour App", sessions_path, icon: "arrow-left" %>
    </nav>

    <div class="border-t border-gray-200 pt-4 mt-auto">
      <%= link_to '#', method: :delete, class: "flex items-center gap-2 px-3 py-2 rounded-none hover:bg-gray-100 text-gray-800 font-medium" do %>
        <%= lucide_icon('log-out', class: 'w-5 h-5 text-brand') %>
        <span>Déconnexion</span>
      <% end %>
    </div>
  </div>
</aside>
